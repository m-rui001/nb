\:6570", "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"drawHexagon", "[", 
     RowBox[{"x_", ",", "y_", ",", "r_"}], "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"EdgeForm", "[", 
       RowBox[{"{", "Green", "}"}], "]"}], ",", 
      RowBox[{"FaceForm", "[", "White", "]"}], ",", 
      RowBox[{"Polygon", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"x", "+", 
            RowBox[{"r", " ", 
             RowBox[{"Cos", "[", "theta", "]"}]}]}], ",", 
           RowBox[{"y", "+", 
            RowBox[{"r", " ", 
             RowBox[{"Sin", "[", "theta", "]"}]}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"theta", ",", 
           RowBox[{"Pi", "/", "6"}], ",", 
