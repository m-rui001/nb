\:504f\:79fb", " ", 
          RowBox[{"dx", "/", "2"}]}], "*)"}], 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"OddQ", "[", "j", "]"}], ",", 
          RowBox[{"x", "+=", 
           RowBox[{"dx", "/", "2"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", "\:6dfb\:52a0\:5230\:753b\:56fe\:5217\:8868", "*)"}], 
        RowBox[{"AppendTo", "[", 
         RowBox[{"graphicList", ",", 
          RowBox[{"drawHexagon", "[", 
           RowBox[{"x", ",", "y", ",", "r"}], "]"}]}], "]"}], ";"}]}], 
      "]"}]}], "]"}], "\[IndentingNewLine]", "\n", 
