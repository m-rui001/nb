      "thetassol", ",", "wssol", ",", "tElecSsol", ",", "triggerSsol"}], 
      "}"}], "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"thetas", "'"}], "[", "t", "]"}], "\[Equal]", 
          RowBox[{"ws", "[", "t", "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"ws", "'"}], "[", "t", "]"}], "\[Equal]", 
          RowBox[{"tElecS", "[", "t", "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"tElecS", "[", "t", "]"}], "\[Equal]", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"triggerS", "[", "t", "]"}]}], "*", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"Sin", "[", 
               RowBox[{"2", "*", "Pi", "*", "2", "*", "t"}], "]"}]}], "+", 
             RowBox[{"Sin", "[", 
              RowBox[{
               RowBox[{"2", "*", "Pi", "*", "3", "*", "t"}], "+", "1"}], 
              "]"}]}], "]"}]}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"triggerS", "[", "t", "]"}], "\[Equal]", "1"}], ",", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", "\:521d\:59cb\:6761\:4ef6", "*)"}], 
         RowBox[{
          RowBox[{"thetas", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
         RowBox[{
          RowBox[{"ws", "[", "0", "]"}], "\[Equal]", "100"}], ",", 
         RowBox[{
          RowBox[{"tElecS", "[", "0", "]"}], "\[Equal]", 
          RowBox[{"-", 
           RowBox[{"Sin", "[", "1", "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"triggerS", "[", "0", "]"}], "\[Equal]", "1"}], ",", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", "\:5224\:5b9a\:6761\:4ef6", "*)"}], 
         RowBox[{"WhenEvent", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"Sin", "[", 
              RowBox[{"2", "*", "Pi", "*", "2", "*", "t"}], "]"}], "]"}], ">", 
            RowBox[{"Abs", "[", 
             RowBox[{"Sin", "[", 
              RowBox[{
               RowBox[{"2", "*", "Pi", "*", "3", "*", "t"}], "+", "1"}], 
              "]"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"triggerS", "[", "t", "]"}], "=", "0"}], "}"}]}], 
          "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
