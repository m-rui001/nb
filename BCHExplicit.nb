(* Beginning of Notebook Content *)
Notebook[{
Cell["\<\
This file contains explicit expressions for both the Baker-Campbell-Hausdorff \
(BCH) series and the symmetric BCH series in terms of right-nested \
commutators. It accompanies the paper  \[OpenCurlyDoubleQuote]A note on the \
Baker-Campbell-Hausdorff series in terms of right-nested commutators\
\[CloseCurlyDoubleQuote], by
A. Arnal, F. Casas, and C. Chiralt\
\>", "Text",
 CellChangeTimes->{{3.782024337212205*^9, 
  3.782024412871677*^9}},ExpressionUUID->"3d095c57-ea8d-414d-9f2e-\
6500e33db3a2"],

Cell["\<\
The symbol Cmt[.,.] stands for the usual commutator (or Lie bracket)\
\>", "Text",
 CellChangeTimes->{{3.7820237839952993`*^9, 
  3.782023812916195*^9}},ExpressionUUID->"c9d3fec2-a337-4f23-b423-\
eb903b29d49f"],

Cell[CellGroupData[{

Cell[TextData[{
 "Explicit expression for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPhi]", "m"], "(", 
    RowBox[{"X", ",", "Y"}], ")"}], TraditionalForm]],ExpressionUUID->
  "b496debc-7bb1-4ccc-b5fa-f486c87d4604"],
 " in\n\[CapitalPhi] = log(exp(X) exp(Y)) = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"m", "=", "1"}], "10"], 
    RowBox[{
     SubscriptBox["\[CapitalPhi]", "m"], "(", 
     RowBox[{"X", ",", "Y"}], ")"}]}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "5c357ecd-7ed7-4c72-96f0-123a587aeab8"]
}], "Section",
 CellChangeTimes->{{3.7820235664209423`*^9, 3.782023610271817*^9}, {
  3.782024068495364*^9, 3.782024087149705*^9}, {3.7820241414993153`*^9, 
