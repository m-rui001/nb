               DisplayFunction -> Identity, DefaultBaseStyle -> {"Graphics", 
                  Directive[
                   EdgeForm[
                    Directive[
                    Opacity[0.3], 
                    GrayLevel[0]]], 
                   PointSize[0.5], 
                   AbsoluteThickness[1.6], 
                   RGBColor[0, 0, 1]]}, ImageSize -> {50, 20}, ImageSize -> 
                100, ImagePadding -> All, PlotRangePadding -> None, 
                AspectRatio -> Full}, {
               AspectRatio -> Full, ImageSize -> {50, 20}, PlotRangePadding -> 
                None, ImagePadding -> Automatic, 
                BaselinePosition -> (Scaled[0.30000000000000004`] -> 
                 Baseline)}], #2}, {
              GraphicsBox[{
                Opacity[0.5], 
                RGBColor[1, 0, 0], 
                RectangleBox[{0, 0}, {4, 1}], 
                RGBColor[0, 1, 0], 
                Thickness[0.03], 
                Dashing[{Small, Small}], 
                LineBox[{{0, 0.5}, {4, 0.5}}]}, {
               DisplayFunction -> Identity, DefaultBaseStyle -> {"Graphics", 
                  Directive[
                   EdgeForm[
                    Directive[
                    Opacity[0.3], 
                    GrayLevel[0]]], 
                   PointSize[0.5], 
                   AbsoluteThickness[1.6], 
                   RGBColor[1, 0, 0]]}, ImageSize -> {50, 20}, ImageSize -> 
                100, ImagePadding -> All, PlotRangePadding -> None, 
                AspectRatio -> Full}, {
