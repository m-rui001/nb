  Editable->True,
  InterpretationFunction:>(RowBox[{"SwatchLegend", "[", 
     RowBox[{
       RowBox[{"{", 
         RowBox[{
           
           TemplateBox[<|"color" -> RGBColor[0, 1, 0]|>, 
            "RGBColorSwatchTemplate"], ",", 
           
