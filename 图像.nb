           RowBox[{"Re", "@", 
            SqrtBox[
             RowBox[{"Gall", "[", 
              RowBox[{
               RowBox[{"u", "[", "x", "]"}], ",", "av", ",", "b", ",", "q", 
               ",", "m", ",", 
               RowBox[{"-", "1"}]}], "]"}]]}]}], ",", 
          RowBox[{
           RowBox[{"u", "[", "0", "]"}], "\[Equal]", "0"}]}], "}"}], ",", "u",
         ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "0", ",", "tphi"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"avp", "=", 
      RowBox[{"3", "m"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"r0", "=", 
      RowBox[{"-", "m"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"u0", "=", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"r0", "+", "avp"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"solp", "=", 
      RowBox[{"NDSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"u", "[", "x", "]"}], ",", "x"}], "]"}], "\[Equal]", 
           RowBox[{"Re", "@", 
            SqrtBox[
             RowBox[{"Gall", "[", 
              RowBox[{
               RowBox[{"u", "[", "x", "]"}], ",", "avp", ",", "b", ",", "q", 
               ",", "m", ",", "1"}], "]"}]]}]}], ",", 
          RowBox[{
           RowBox[{"u", "[", "tphi", "]"}], "\[Equal]", "u0"}]}], "}"}], ",", 
        "u", ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "tphi", ",", "tphip"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tphim", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "0.5"}], " ", "Pi"}], "-", 
       RowBox[{"Pi", " ", "tphim"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"um", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"#", "\[GreaterEqual]", " ", "tphi"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"u", "[", "#", "]"}], "/.", 
             RowBox[{"sol", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"u", "[", "#", "]"}], "/.", 
             RowBox[{"solp", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ",", 
            RowBox[{"-", "1"}]}], "}"}]}], "]"}], "&"}], "/@", "tphim"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"rm", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ">", "0"}], ",", 
          RowBox[{
           RowBox[{"1", "/", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "-", "av"}], ",", 
          RowBox[{
           RowBox[{"1", "/", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "-", "avp"}]}], "]"}], "&"}], "/@",
        "um"}]}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->"In[78]:=",ExpressionUUID->"ebedf5cc-ce47-4d7c-aa97-8c6a80fcf87c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Iob", "[", 
   RowBox[{"Iem_", ",", "b_", ",", "q_", ",", "m_", ",", "lor_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", "rofmv", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"rofmv", "=", 
      RowBox[{"rofm", "[", 
       RowBox[{"b", ",", "q", ",", "m", ",", "lor"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"lor", "\[Equal]", "1"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           FractionBox[
            SuperscriptBox[
             RowBox[{"h", "[", 
              RowBox[{"#", ",", "q", ",", "m"}], "]"}], "2"], 
            SuperscriptBox["\[ExponentialE]", 
             RowBox[{"-", 
              FractionBox[
               RowBox[{"m", " ", "\[Pi]"}], 
               SqrtBox[
                RowBox[{
                 RowBox[{"-", 
                  SuperscriptBox["m", "2"]}], "+", 
                 SuperscriptBox["q", "2"]}]]]}]]], " ", 
           RowBox[{"Iem", "[", "#", "]"}]}], "&"}], "/@", "rofmv"}], "//", 
        "Total"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           FractionBox[
            SuperscriptBox[
             RowBox[{"h", "[", 
              RowBox[{"#", ",", "q", ",", "m"}], "]"}], "2"], 
            SuperscriptBox["\[ExponentialE]", 
             FractionBox[
              RowBox[{"m", " ", "\[Pi]"}], 
              SqrtBox[
               RowBox[{
                RowBox[{"-", 
                 SuperscriptBox["m", "2"]}], "+", 
                SuperscriptBox["q", "2"]}]]]]], " ", 
           RowBox[{"Iem", "[", "#", "]"}]}], "&"}], "/@", "rofmv"}], "//", 
        "Total"}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->"In[79]:=",ExpressionUUID->"a063eb6d-3e99-47bf-866c-5ff4bb6b8714"],

