Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"V", "[", "r_", "]"}], "=", 
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      RowBox[{"h", "[", 
       RowBox[{"r", ",", "q", ",", "m"}], "]"}], 
      RowBox[{"R2", "[", 
       RowBox[{"r", ",", "q", ",", "m"}], "]"}]], "-", 
     RowBox[{"\[Epsilon]", " ", 
      FractionBox[
       RowBox[{"h", "[", 
        RowBox[{"r", ",", "q", ",", "m"}], "]"}], 
       SuperscriptBox["L", "2"]]}]}], ")"}]}], ";", 
  RowBox[{"\[Epsilon]", "=", 
   RowBox[{"-", "1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"risco", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "3"}], " ", "m"}], "-", 
    SqrtBox[
     RowBox[{
      RowBox[{"4", " ", 
       SuperscriptBox["m", "2"]}], "+", 
      SuperscriptBox["q", "2"]}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Lisco", "=", 
   RowBox[{"Re", "[", 
    RowBox[{
     FractionBox[
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        FractionBox[
         RowBox[{"m", " ", 
          RowBox[{"ArcTan", "[", 
           FractionBox["r", 
            SqrtBox[
             RowBox[{
              RowBox[{"-", 
               SuperscriptBox["m", "2"]}], "+", 
              SuperscriptBox["q", "2"]}]]], "]"}]}], 
         SqrtBox[
          RowBox[{
           RowBox[{"-", 
            SuperscriptBox["m", "2"]}], "+", 
           SuperscriptBox["q", "2"]}]]]], " ", 
       SqrtBox["m"], " ", 
       SqrtBox[
        RowBox[{
         SuperscriptBox["m", "2"], "-", 
         SuperscriptBox["q", "2"], "-", 
         SuperscriptBox["r", "2"]}]]}], 
      SqrtBox[
       RowBox[{
        RowBox[{"2", " ", "m"}], "+", "r"}]]], "/.", 
     RowBox[{"r", "\[Rule]", "risco"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Lisco", "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"m", "\[Rule]", "mv"}], ",", 
     RowBox[{"q", "\[Rule]", "qv"}]}], "}"}]}], "//", "N"}]}], "Input",
 CellChangeTimes->{{3.9108538645955334`*^9, 3.9108538857954082`*^9}},
 CellLabel->"In[67]:=",ExpressionUUID->"cb5b35f8-7b06-4aed-bb18-0933ed79131d"],

