Notebook[{
Cell[BoxData[
 RowBox[{"Quit", "[", "]"}]], "Input",
 CellChangeTimes->{{3.9104239564994745`*^9, 3.9104239587765055`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"680f7ca2-260c-4457-965f-5ddf4e141271"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"j", "=", "1"}], ";", 
  RowBox[{"a", "=", 
   RowBox[{"ImplicitRegion", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox["x", "2"], "+", 
        SuperscriptBox["y", "2"]}], "\[LessEqual]", "1"}], "&&", 
      RowBox[{"y", "\[GreaterEqual]", 
       RowBox[{"x", "+", "38"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"n", "=", "5"}], ";", 
  RowBox[{"While", "[", 
   RowBox[{
    RowBox[{"j", "\[LessEqual]", "n"}], ",", 
    RowBox[{
     RowBox[{"i", "=", "0"}], ";", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{"i", "\[LessEqual]", "j"}], ",", 
       RowBox[{
        RowBox[{"d", "=", 
         RowBox[{"ImplicitRegion", "[", 
          RowBox[{
           RowBox[{"y", "\[GreaterEqual]", 
            RowBox[{"j", "*", 
             RowBox[{"(", 
              RowBox[{"x", "-", 
               FractionBox["i", "j"]}], ")"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], ";", 
        RowBox[{"e", "=", 
         RowBox[{"ImplicitRegion", "[", 
          RowBox[{
           RowBox[{"y", "\[GreaterEqual]", 
            RowBox[{
             RowBox[{"-", "j"}], "*", 
             RowBox[{"(", 
              RowBox[{"x", "-", 
               FractionBox["i", "j"]}], ")"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], ";", 
        RowBox[{"c", "=", 
         RowBox[{"RegionIntersection", "[", 
          RowBox[{"d", ",", "e"}], "]"}]}], ";", 
        RowBox[{"a", "=", 
         RowBox[{"RegionUnion", "[", 
          RowBox[{"a", ",", "c"}], "]"}]}], ";", 
        RowBox[{"i", "++"}]}]}], "]"}], ";", 
     RowBox[{"j", "++"}]}]}], "]"}], ";", 
  RowBox[{"RegionPlot", "[", 
   RowBox[{"a", ",", 
    RowBox[{"Axes", "\[Rule]", "True"}], ",", 
    RowBox[{"Frame", "\[Rule]", "True"}], ",", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.91042237740986*^9, 3.9104223817178507`*^9}, {
  3.910422505933933*^9, 3.9104225836690755`*^9}, {3.9104237277895823`*^9, 
