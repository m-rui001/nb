Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"prettyPrintFactorization", "[", "n_Integer", "]"}], ":=", 
   RowBox[{"Row", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{"n", ",", "\[IndentingNewLine]", 
       RowBox[{"Row", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"factor", "|->", 
            RowBox[{"With", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"base", "=", 
                 RowBox[{"factor", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], ",", 
                RowBox[{"exponent", "=", 
                 RowBox[{"factor", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"Superscript", "[", 
               RowBox[{"base", ",", "exponent"}], "]"}]}], 
             "\[IndentingNewLine]", "]"}]}], ")"}], "/@", 
          RowBox[{"FactorInteger", "[", "n", "]"}]}], ",", 
         "\[IndentingNewLine]", "\"\<\[Cross]\>\""}], "\[IndentingNewLine]", 
        "]"}]}], "\[IndentingNewLine]", "}"}], ",", "\"\<==\>\""}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"prettyPrintFactorizationList", "[", 
    RowBox[{"list_List", ",", 
     RowBox[{"rows_Integer", ":", "1"}]}], "]"}], ":=", 
   RowBox[{"Grid", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Transpose", "@", 
      RowBox[{"Array", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"row", ",", "col"}], "}"}], "|->", 
         RowBox[{"If", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"row", "-", "1"}], ")"}], " ", "rows"}], "+", "col"}], 
            "<=", 
            RowBox[{"Length", "[", "list", "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"prettyPrintFactorization", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"row", "-", "1"}], ")"}], " ", "rows"}], "+", "col"}], 
            "]"}], ",", "\[IndentingNewLine]", "\"\<\>\""}], 
          RowBox[{
          "(*", "\:4e0b\:6807\:8d8a\:754c\:8fd4\:56de\:7a7a\:5b57\:7b26\:4e32\
", "*)"}], "\[IndentingNewLine]", "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Ceiling", "[", 
           RowBox[{
            RowBox[{"Length", "[", "list", "]"}], "/", "rows"}], "]"}], ",", 
          "rows"}], "}"}]}], "\[IndentingNewLine]", "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Frame", "->", "All"}], ",", 
     RowBox[{"Alignment", "->", "Left"}], ",", 
     RowBox[{"ItemSize", "->", "All"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"prettyPrintFactorizationList", "[", 
