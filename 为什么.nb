Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"r", "[", "i_", "]"}], ":=", 
   RowBox[{"h", "+", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "i"}], "-", "1"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "n"}], ")"}]}], "*", "L2", " ", 
     RowBox[{"Sin", "[", "\[Alpha]", "]"}], " ", 
     RowBox[{"Cot", "[", "\[Theta]", "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Alpha]", "=", 
   RowBox[{"10", " ", "Degree"}]}], ";", 
  RowBox[{"\[CurlyPhi]1", "=", "0"}], ";", 
  RowBox[{"\[CurlyPhi]2", "=", "0"}], ";", 
  RowBox[{"L2", "=", "65"}], ";", 
  RowBox[{"L1", "=", "65"}], ";", 
  RowBox[{"Wmax", "=", 
   RowBox[{"-", "1.6"}]}], ";", 
  RowBox[{"h", "=", "900"}], ";", 
  RowBox[{"n", "=", "10"}], ";", 
  RowBox[{"\[Theta]", "=", 
   RowBox[{"85", " ", "Degree"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"W", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Wmax", "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{
            RowBox[{"Tan", "[", "\[Alpha]", "]"}], " ", 
            RowBox[{"Cot", "[", "\[Theta]", "]"}]}]}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Erf", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Sqrt", "[", "Pi", "]"}], "/", 
              RowBox[{"r", "[", "i", "]"}]}], " ", 
             RowBox[{"(", 
              RowBox[{"y", "-", 
               RowBox[{"h", " ", 
                RowBox[{"Cot", "[", "\[Theta]", "]"}]}], "-", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"i", "-", "1"}], ")"}], "/", "n"}], ")"}], " ", 
                "L2", " ", 
                RowBox[{"Cos", "[", "\[Alpha]", "]"}], " ", 
                RowBox[{"Cos", "[", "\[CurlyPhi]1", "]"}], " ", 
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  RowBox[{
                   RowBox[{"Tan", "[", "\[Alpha]", "]"}], " ", 
                   RowBox[{"Cot", "[", "\[Theta]", "]"}]}]}], ")"}]}]}], 
              ")"}]}], "]"}], "-", 
           RowBox[{"Erf", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Sqrt", "[", "Pi", "]"}], "/", 
              RowBox[{"r", "[", "i", "]"}]}], " ", 
             RowBox[{"(", 
              RowBox[{"y", "-", 
               RowBox[{"h", " ", 
                RowBox[{"Cot", "[", "\[Theta]", "]"}]}], "-", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"i", "/", "n"}], ")"}], "*", "L2", " ", 
                RowBox[{"Cos", "[", "\[Alpha]", "]"}], " ", 
                RowBox[{"Cos", "[", "\[CurlyPhi]1", "]"}], " ", 
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  RowBox[{
                   RowBox[{"Tan", "[", "\[Alpha]", "]"}], " ", 
                   RowBox[{"Cot", "[", "\[Theta]", "]"}]}]}], ")"}]}]}], 
              ")"}]}], "]"}]}], ")"}]}], " ", ")"}]}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Erf", "[", 
           RowBox[{
            RowBox[{"Sqrt", "[", "Pi", "]"}], " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"x", "+", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"i", "-", "1"}], ")"}], "/", "n"}], "*", "L2", " ", 
                RowBox[{"Sin", "[", "\[CurlyPhi]1", "]"}]}]}], ")"}], "/", 
             RowBox[{"r", "[", "i", "]"}]}]}], "]"}], "-", 
          RowBox[{"Erf", "[", 
           RowBox[{
            RowBox[{"Sqrt", "[", "Pi", "]"}], " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"x", "+", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"i", "-", "1"}], ")"}], "/", "n"}], "*", "L2", " ", 
                RowBox[{"Sin", "[", "\[CurlyPhi]1", "]"}]}], "-", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"L1", "+", 
                  RowBox[{"L2", " ", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"2", " ", "i"}], "-", "1"}], ")"}], "/", 
                    RowBox[{"(", 
                    RowBox[{"2", " ", "n"}], ")"}]}]}]}], ")"}], " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Sin", "[", "\[CurlyPhi]1", "]"}], "+", 
                  RowBox[{"Cos", "[", "\[CurlyPhi]1", "]"}], "+", 
                  RowBox[{"Tan", "[", "\[CurlyPhi]2", "]"}]}], ")"}]}]}], 
              ")"}], "/", 
             RowBox[{"r", "[", "i", "]"}]}]}], "]"}]}], ")"}], ")"}], "/", 
       "2"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "100"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"Plot3D", "[", 
   RowBox[{
    RowBox[{"W", "[", 
     RowBox[{"x", ",", "y"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "1000"}], ",", "2000"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", 
      RowBox[{"-", "1000"}], ",", "1000"}], "}"}], ",", 
    RowBox[{"PlotRange", "->", "All"}], ",", 
    RowBox[{"AxesLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<x\>\"", ",", "\"\<y\>\"", ",", "\"\<W[x, y]\>\""}], 
      "}"}]}], ",", 
