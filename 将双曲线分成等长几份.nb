Notebook[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  SqrtBox[
   RowBox[{
    RowBox[{"-", "1"}], "+", 
    SuperscriptBox["x", "2"]}]]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"length", "[", 
    RowBox[{
     RowBox[{"xf_", "?", "NumericQ"}], ",", "f_"}], "]"}], ":=", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"1", "+", 
       RowBox[{
        RowBox[{
         RowBox[{"f", "'"}], "[", "z", "]"}], "^", "2"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "1", ",", "xf"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"findx", "[", 
    RowBox[{"ell_", ",", "f_"}], "]"}], ":=", 
   RowBox[{"x", "/.", " ", 
    RowBox[{"FindRoot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"length", "[", 
        RowBox[{"x", ",", "f"}], "]"}], "\[Equal]", "ell"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "1"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"xup", "=", "8"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"totalLength", "=", 
   RowBox[{"length", "[", 
    RowBox[{"xup", ",", "f"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"dL", "=", 
     RowBox[{"totalLength", "/", "nsegs"}]}], ";", "\n", 
    RowBox[{"xvals", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"findx", "[", 
        RowBox[{
         RowBox[{"n", "*", "dL"}], ",", "f"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "0", ",", "nsegs"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Show", "[", 
     RowBox[{
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"f", "[", "x", "]"}], ",", 
          RowBox[{"-", 
           RowBox[{"f", "[", "x", "]"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"-", "xup"}], ",", "xup"}], "}"}]}], "]"}], ",", 
      RowBox[{"Graphics", "[", 
       RowBox[{"{", 
        RowBox[{"Red", ",", 
         RowBox[{"PointSize", "[", "Large", "]"}], ",", 
         RowBox[{"Point", "[", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"xvals", ",", 
             RowBox[{"f", "/@", "xvals"}]}], "}"}], "]"}], "]"}], ",", 
         RowBox[{"Point", "[", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "xvals"}], ",", 
             RowBox[{"f", "/@", 
              RowBox[{"-", "xvals"}]}]}], "}"}], "]"}], "]"}], ",", 
         RowBox[{"Point", "[", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"xvals", ",", 
             RowBox[{"-", 
              RowBox[{"f", "/@", "xvals"}]}]}], "}"}], "]"}], "]"}], ",", 
         RowBox[{"Point", "[", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "xvals"}], ",", 
             RowBox[{"-", 
              RowBox[{"f", "/@", 
               RowBox[{"-", "xvals"}]}]}]}], "}"}], "]"}], "]"}]}], "}"}], 
       "]"}], ",", 
      RowBox[{"AspectRatio", "\[Rule]", "Automatic"}]}], 
     "\[IndentingNewLine]", "\n", "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"nsegs", ",", "1", ",", "\"\<nsegs\>\""}], "}"}], ",", "1", ",",
      "10", ",", "1", ",", 
     RowBox[{"Appearance", "\[Rule]", "\"\<Labeled\>\""}]}], "}"}], ",", 
   RowBox[{"ControlPlacement", "\[Rule]", "Top"}], ",", 
