     RowBox[{"\[CapitalOmega]", "=", 
      RowBox[{"\[CapitalOmega]0", "/", 
       RowBox[{"(", 
        RowBox[{"r", "/", "100"}], ")"}]}]}], ";", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"j", "=", "0"}], ",", 
       RowBox[{"j", "\[LessEqual]", "100"}], ",", 
       RowBox[{"j", "++"}], ",", 
       RowBox[{
        RowBox[{"\[Alpha]", "=", 
         RowBox[{"3", "*", 
          RowBox[{"j", "/", "100"}]}]}], ";", 
        RowBox[{"qqss", "=", 
         RowBox[{"NDSolve", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"41223.85394254427`", " ", 
                  RowBox[{"q1", "[", "t", "]"}]}], "+", 
                 RowBox[{"2902.967893800643`", " ", 
                  SuperscriptBox[
                   RowBox[{"q1", "[", "t", "]"}], "3"]}], "+", 
                 RowBox[{"11611.871575202573`", " ", 
                  RowBox[{"q1", "[", "t", "]"}], " ", 
