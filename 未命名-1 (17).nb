               FractionBox["1", "2"], "*", "de", "*", "da", "*", 
               RowBox[{
                RowBox[{"e", "[", 
                 RowBox[{"x", ",", "t"}], "]"}], "^", "2"}]}]}], ")"}], 
            RowBox[{"\[DifferentialD]", "x"}]}]}]}]}], ";", 
        RowBox[{
         RowBox[{"cez", "[", "t_", "]"}], ":=", 
         RowBox[{"Chop", "[", 
          RowBox[{"ez", "[", "t", "]"}], "]"}]}], ";", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"i", "=", "0"}], ";", 
           RowBox[{"min", "=", "100000000"}]}], ",", 
          RowBox[{"i", "\[LessEqual]", "600"}], ",", 
          RowBox[{"i", "++"}], ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"cez", "[", 
              RowBox[{"4950", "+", 
               RowBox[{"i", "/", "100"}]}], "]"}], "<", "min"}], ",", 
            RowBox[{"min", "=", 
