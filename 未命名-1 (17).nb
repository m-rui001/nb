                   RowBox[{"q2", "[", "t", "]"}], "2"]}], "+", 
                 RowBox[{"149.7163452732078`", " ", 
                  RowBox[{
                   SuperscriptBox["q1", "\[Prime]",
                    MultilineFunction->None], "[", "t", "]"}]}], "+", 
                 RowBox[{"1374.5385921186019`", " ", 
                  RowBox[{
                   SuperscriptBox["q1", "\[Prime]\[Prime]",
                    MultilineFunction->None], "[", "t", "]"}]}]}], ")"}], "+", 
               RowBox[{"(", 
                RowBox[{"-", 
                 FractionBox[
                  RowBox[{"dp", " ", "l", " ", 
                   RowBox[{"Cos", "[", 
                    RowBox[{"t", " ", "\[CapitalOmega]"}], "]"}], " ", 
                   RowBox[{"Sin", "[", 
                    RowBox[{"\[Pi]", " ", "\[Alpha]"}], "]"}]}], 
                  RowBox[{"\[Pi]", "-", 
                   RowBox[{"\[Pi]", " ", 
                    SuperscriptBox["\[Alpha]", "2"]}]}]]}], ")"}]}], 
              "\[Equal]", "0"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"164895.4157701771`", " ", 
                  RowBox[{"q2", "[", "t", "]"}]}], "+", 
                 RowBox[{"11611.871575202573`", " ", 
                  SuperscriptBox[
                   RowBox[{"q1", "[", "t", "]"}], "2"], " ", 
                  RowBox[{"q2", "[", "t", "]"}]}], "+", 
                 RowBox[{"46447.48630081029`", " ", 
                  SuperscriptBox[
                   RowBox[{"q2", "[", "t", "]"}], "3"]}], "+", 
                 RowBox[{"149.7163452732078`", " ", 
                  RowBox[{
                   SuperscriptBox["q2", "\[Prime]",
                    MultilineFunction->None], "[", "t", "]"}]}], "+", 
                 RowBox[{"1374.5385921186019`", " ", 
                  RowBox[{
                   SuperscriptBox["q2", "\[Prime]\[Prime]",
                    MultilineFunction->None], "[", "t", "]"}]}]}], ")"}], "+", 
               RowBox[{"(", 
                RowBox[{"-", 
                 FractionBox[
                  RowBox[{"2", " ", "dp", " ", "l", " ", 
                   RowBox[{"Cos", "[", 
                    RowBox[{"t", " ", "\[CapitalOmega]"}], "]"}], " ", 
                   RowBox[{"Sin", "[", 
                    RowBox[{"\[Pi]", " ", "\[Alpha]"}], "]"}]}], 
                  RowBox[{"\[Pi]", " ", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "4"}], "+", 
                    SuperscriptBox["\[Alpha]", "2"]}], ")"}]}]]}], ")"}]}], 
              "\[Equal]", "0"}], ",", 
             RowBox[{
              RowBox[{"q1", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
             RowBox[{
              RowBox[{"q2", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
             RowBox[{
              RowBox[{
               SuperscriptBox["q1", "\[Prime]",
                MultilineFunction->None], "[", "0", "]"}], "\[Equal]", "0"}], 
             ",", 
             RowBox[{
              RowBox[{
               SuperscriptBox["q2", "\[Prime]",
                MultilineFunction->None], "[", "0", "]"}], "\[Equal]", 
              "0"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"q1", ",", "q2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "5000"}], "}"}], ",", 
           RowBox[{"MaxSteps", "\[Rule]", 
            SuperscriptBox["10", "10"]}]}], "]"}]}], ";", 
        RowBox[{"qqs1", "=", 
         RowBox[{"First", "[", 
          RowBox[{"q1", "/.", "qqss"}], "]"}]}], ";", 
        RowBox[{"qqs2", "=", 
         RowBox[{"First", "[", 
          RowBox[{"q2", "/.", "qqss"}], "]"}]}], ";", 
        RowBox[{
         RowBox[{"v", "[", 
          RowBox[{"x_", ",", "t_"}], "]"}], ":=", 
