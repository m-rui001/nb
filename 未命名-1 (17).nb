              RowBox[{"4950", "+", 
               RowBox[{"i", "/", "100"}]}], "]"}]}]}], "]"}]}], "]"}], ";", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"i", "=", "0"}], ";", 
           RowBox[{"max", "=", 
            RowBox[{"-", "100000000"}]}]}], ",", 
          RowBox[{"i", "\[LessEqual]", "600"}], ",", 
          RowBox[{"i", "++"}], ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"cez", "[", 
              RowBox[{"4950", "+", 
               RowBox[{"i", "/", "100"}]}], "]"}], ">", "max"}], ",", 
            RowBox[{"max", "=", 
             RowBox[{"cez", "[", 
              RowBox[{"4950", "+", 
               RowBox[{"i", "/", "100"}]}], "]"}]}]}], "]"}]}], "]"}], ";", 
        RowBox[{"znl", "=", 
         FractionBox[
          RowBox[{"max", "+", "min"}], "2"]}], ";", 
        RowBox[{
         RowBox[{"cc", "[", "ff", "]"}], "=", "znl"}], ";", 
        RowBox[{
         RowBox[{"hh", "[", "ff", "]"}], "=", 
         RowBox[{"r", "/", "100"}]}], ";", 
        RowBox[{
         RowBox[{"ii", "[", "ff", "]"}], "=", 
         RowBox[{"Integrate", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Sin", "[", 
              RowBox[{"\[Alpha]", "*", "Pi", "*", 
               RowBox[{"x", "/", "l"}]}], "]"}], "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Sin", "[", 
                RowBox[{"Pi", "*", 
                 RowBox[{"x", "/", "l"}]}], "]"}], "+", 
               RowBox[{"Sin", "[", 
                RowBox[{"2", "*", "Pi", "*", 
                 RowBox[{"x", "/", "l"}]}], "]"}]}], ")"}]}], ")"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "0", ",", "l"}], "}"}]}], "]"}]}], ";", 
        RowBox[{
         RowBox[{"pp", "[", "ff", "]"}], "=", "\[Alpha]"}], ";", 
        RowBox[{"ff", "++"}], ";", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"znl", "<", "znlmin"}], ",", 
          RowBox[{
           RowBox[{"znlmin", "=", "znl"}], ";", 
           RowBox[{"znlminf", "=", 
            RowBox[{"r", "/", "100"}]}], ";", 
           RowBox[{"znlmin\[Alpha]", "=", "\[Alpha]"}]}]}], "]"}], ";", 
