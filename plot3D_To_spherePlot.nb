  3.875333754144105*^9}},ExpressionUUID->"49a8e7be-7a33-4f2d-8cce-\
77b960b23beb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"x0", "=", "0."}], ";"}], "\n", 
 RowBox[{
  RowBox[{"y0", "=", "3."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fun", "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"N", "@", "\[Pi]"}]], 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      SuperscriptBox[
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"2", "\[Alpha]"}], "-", "\[Alpha]0"}], "]"}], "2"]}]]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Qfun", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Re", "@", "fun"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Alpha]", "->", 
       RowBox[{"x", "+", 
        RowBox[{"\[ImaginaryI]", " ", "y"}]}]}], ",", 
      RowBox[{"\[Alpha]0", "->", 
       RowBox[{"x0", "+", 
        RowBox[{"\[ImaginaryI]", " ", "y0"}]}]}]}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{"Qfun", "[", 
    RowBox[{"x", ",", "y"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", "0", ",", "\[Pi]"}], "}"}], ",", 
   RowBox[{"ColorFunction", "->", "\"\<TemperatureMap\>\""}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
   RowBox[{"PlotPoints", "\[Rule]", "80"}], ",", 
   RowBox[{"ImageSize", "->", "400"}], ",", "\n", "\t\t", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Re[\[Alpha]]\>\"", ",", 
        RowBox[{"FontFamily", "\[Rule]", "\"\<Times\>\""}], ",", 
        RowBox[{"FontSize", "\[Rule]", "15"}], ",", 
        RowBox[{"FontColor", "\[Rule]", "Black"}]}], "]"}], ",", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Im[\[Alpha]]\>\"", ",", 
        RowBox[{"FontFamily", "\[Rule]", "\"\<Times\>\""}], ",", 
        RowBox[{"FontSize", "\[Rule]", "15"}], ",", 
        RowBox[{"FontColor", "\[Rule]", "Black"}]}], "]"}]}], "}"}]}]}], 
  "]"}]}], "Code",
