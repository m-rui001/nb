Cell[TextData[StyleBox["\:60f3\:628a\:5b83\:753b\:5728\:7403\:9762\:4e0a",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.87533375974914*^9, 
  3.875333770584113*^9}},ExpressionUUID->"c91ce7cd-ec47-4cf3-b7e8-\
39447e90a67c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Q", "[", 
    RowBox[{"\[Theta]_", ",", "\[Phi]_"}], "]"}], ":=", 
   RowBox[{"Qfun", "[", 
    RowBox[{"\[Theta]", ",", "\[Phi]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Qmax", "=", 
   RowBox[{
    RowBox[{"NMaximize", "[", 
     RowBox[{
      RowBox[{"Q", "[", 
       RowBox[{"x", ",", "y"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y"}], "}"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Qfunc", "=", 
  RowBox[{"ParametricPlot3D", "[", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", " ", "\[Phi]", "]"}], " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", 
      RowBox[{
       RowBox[{"Sin", "[", "\[Phi]", "]"}], 
       RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", 
      RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Phi]", ",", 
      RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"\[Theta]", ",", " ", "0", ",", "\[Pi]"}], "}"}], ",", 
    RowBox[{"PlotPoints", " ", "\[Rule]", " ", "100"}], ",", "\n", 
    "\t                   ", 
    RowBox[{"Mesh", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"7", ",", "7"}], "}"}]}], ",", 
    RowBox[{"MeshStyle", "\[Rule]", 
     RowBox[{"Directive", "[", 
      RowBox[{"Thick", ",", "Gray"}], "]"}]}], ",", 
    RowBox[{"PlotStyle", "\[Rule]", 
     RowBox[{"Opacity", "[", "0.95", "]"}]}], ",", "\n", 
    "\t                   ", 
    RowBox[{"ColorFunction", "\[Rule]", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "x", ",", "y", ",", "z", ",", " ", "\[Phi]", ",", " ", "\[Theta]"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"ColorData", "[", "\"\<DarkRainbow\>\"", "]"}], "[", 
        RowBox[{
         RowBox[{"Q", "[", 
          RowBox[{"\[Theta]", ",", "\[Phi]"}], "]"}], "/", "Qmax"}], "]"}]}], 
      "]"}]}], ",", "\n", "\t                   ", 
    RowBox[{"ColorFunctionScaling", "\[Rule]", "False"}], ",", "\n", 
    "\t                   ", 
    RowBox[{"Boxed", "\[Rule]", "False"}], ",", "\n", "\t                   ", 
    RowBox[{
     StyleBox["Axes", "MR"], "\[Rule]", "False"}], ",", "\n", 
    "\t                   ", 
    RowBox[{"ViewPoint", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "1"}], "}"}]}]}], "]"}]}]}], "Code",
 CellChangeTimes->{{3.875331850554638*^9, 3.875331887350437*^9}, 
   3.8753331129240913`*^9, 3.8753334464748425`*^9, {3.8753335106802645`*^9, 
   3.875333516425142*^9}, {3.875333782373126*^9, 3.8753338717841234`*^9}},
 CellLabel->
