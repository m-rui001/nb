Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"rule", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[CapitalOmega]", "->", "0.1"}], ",", 
     RowBox[{"\[Kappa]", "->", "1"}], ",", 
     RowBox[{"\[Chi]", "->", "5"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"C0", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"C1", "=", 
   RowBox[{
    RowBox[{"-", "\[CapitalOmega]"}], "/", 
    RowBox[{"(", 
     RowBox[{"\[EmptyUpTriangle]", "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"I", "*", "\[Kappa]"}], ")"}], "/", "2"}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"C2", "=", 
   RowBox[{
    SqrtBox["2"], 
    RowBox[{
     RowBox[{"\[CapitalOmega]", "^", "2"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[EmptyUpTriangle]", "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"I", "*", "\[Kappa]"}], ")"}], "/", "2"}]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "\[EmptyUpTriangle]"}], "-", 
         RowBox[{"(", 
          RowBox[{"I", "*", "\[Kappa]"}], ")"}], "+", 
         RowBox[{"2", "\[Chi]"}]}], ")"}]}], ")"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"C1", "=", 
   RowBox[{
    RowBox[{"C1", "//.", "rule"}], "//", "FullSimplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"C2", "=", 
   RowBox[{
    RowBox[{"C2", "//.", "rule"}], "//", "FullSimplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"N1", "=", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{"C0", "*", 
      RowBox[{"Conjugate", "[", "C0", "]"}]}], "]"}], "+", 
    RowBox[{"Abs", "[", 
     RowBox[{"C1", "*", 
      RowBox[{"Conjugate", "[", "C1", "]"}]}], "]"}], "+", 
    RowBox[{"Abs", "[", 
     RowBox[{"C2", "*", 
      RowBox[{"Conjugate", "[", "C2", "]"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"P1", "=", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{"C1", "*", 
      RowBox[{"Conjugate", "[", "C1", "]"}]}], "]"}], "/", "N1"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"P2", "=", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{"C2", "*", 
      RowBox[{"Conjugate", "[", "C2", "]"}]}], "]"}], "/", "N1"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"G", "[", "\[EmptyUpTriangle]_", "]"}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"2", "*", "P2"}], ")"}], "/", 
    RowBox[{"P1", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"G", "[", "\[EmptyUpTriangle]", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[EmptyUpTriangle]", ",", 
     RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"(*", "\:542f\:7528\:8fb9\:6846", "*)"}], 
