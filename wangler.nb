Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"jingdu", "=", "150"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fx", "[", 
    RowBox[{"huatu_", ",", 
     RowBox[{"r0_", "?", "NumberQ"}], ",", 
     RowBox[{"r0dao_", "?", "NumberQ"}], ",", 
     RowBox[{"bianjie_", ":", "1"}]}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Eta]", ",", "r"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Eta]", "=", 
        FractionBox["1", "2"]}], "}"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"zhong", ",", "rhh", ",", "jieguo", ",", "tu"}], "}"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"{", "r00", "}"}], "=", 
          RowBox[{
           RowBox[{"{", "r", "}"}], "/.", 
           RowBox[{
            RowBox[{"NDSolve", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"r", "''"}], "[", "s", "]"}], "+", 
                  RowBox[{"r", "[", "s", "]"}], "-", 
                  FractionBox[
                   SuperscriptBox["\[Eta]", "2"], 
                   SuperscriptBox[
                    RowBox[{"r", "[", "s", "]"}], "3"]], "-", 
                  FractionBox[
                   RowBox[{"1", "-", 
                    SuperscriptBox["\[Eta]", "2"]}], 
                   RowBox[{"r", "[", "s", "]"}]]}], "\[Equal]", "0"}], ",", 
                RowBox[{
                 RowBox[{"r", "[", "0", "]"}], "\[Equal]", "r0"}], ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"r", "'"}], "[", "0", "]"}], "\[Equal]", 
                 "r0dao"}]}], "}"}], ",", 
              RowBox[{"{", "r", "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"s", ",", "0", ",", "bianjie"}], "}"}], ",", 
              RowBox[{"WorkingPrecision", "->", "jingdu"}], ",", 
              RowBox[{"PrecisionGoal", "->", " ", "15"}], ",", 
              RowBox[{"AccuracyGoal", "->", "15"}], ",", 
              RowBox[{"MaxSteps", "->", "Infinity"}]}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}]}], ";", 
         RowBox[{"tu", "=", 
          RowBox[{"{", 
           RowBox[{"Plot", "[", 
            RowBox[{
             RowBox[{"r00", "[", "x", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "0", ",", "bianjie"}], "}"}], ",", 
             RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
             RowBox[{"PlotStyle", "\[Rule]", 
              RowBox[{"{", 
               RowBox[{"Bold", ",", "Black"}], "}"}]}], ",", 
             RowBox[{"AxesLabel", "\[Rule]", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{
                  TagBox["\"\<s (m)\>\"",
                   HoldForm], ",", "Black"}], "]"}], ",", 
                RowBox[{"Style", "[", 
                 RowBox[{
                  TagBox["\"\<r (mm)\>\"",
                   HoldForm], ",", "Black"}], "]"}]}], "}"}]}], ",", 
             RowBox[{"LabelStyle", "\[Rule]", 
              RowBox[{"Directive", "[", "Bold", "]"}]}], ",", 
             RowBox[{"AxesStyle", "\[Rule]", 
              RowBox[{"Directive", "[", 
               RowBox[{"Thick", ",", "Italic"}], "]"}]}]}], "]"}], "}"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"huatu", "==", "1"}], ",", "tu", ",", 
           RowBox[{
            RowBox[{"{", "r00", "}"}], "//", "N"}]}], "]"}]}]}], "]"}]}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"fx", "[", 
  RowBox[{"1", ",", 
   FractionBox["62", "100"], ",", "0", ",", "160"}], "]"}]}], "Input",
