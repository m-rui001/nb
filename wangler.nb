Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fxyzyan", "[", 
    RowBox[{"huatu_", ",", 
     RowBox[{"r0_", "?", "NumberQ"}], ",", 
     RowBox[{"r0dao_", "?", "NumberQ"}], ",", 
     RowBox[{"xxiao0_", "?", "NumberQ"}], ",", 
     RowBox[{"xxiao0dao_", "?", "NumberQ"}], ",", 
     RowBox[{"bianjie_", ":", "10"}]}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Eta]", ",", "r", ",", "x"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Eta]", "=", 
        FractionBox["1", "2"]}], "}"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "zhong", ",", "rhh", ",", "jieguo", ",", "tu", ",", "can1", ",", 
          "can2", ",", "can3", ",", "solx", ",", "dians"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"{", "r", "}"}], "=", 
          RowBox[{
           RowBox[{"{", "r", "}"}], "/.", 
           RowBox[{
            RowBox[{"NDSolve", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"r", "''"}], "[", "s", "]"}], "+", 
                  RowBox[{"r", "[", "s", "]"}], "-", 
                  FractionBox[
                   SuperscriptBox["\[Eta]", "2"], 
                   SuperscriptBox[
                    RowBox[{"r", "[", "s", "]"}], "3"]], "-", 
                  FractionBox[
                   RowBox[{"1", "-", 
                    SuperscriptBox["\[Eta]", "2"]}], 
                   RowBox[{"r", "[", "s", "]"}]]}], "\[Equal]", "0"}], ",", 
                RowBox[{
                 RowBox[{"r", "[", "0", "]"}], "\[Equal]", "r0"}], ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"r", "'"}], "[", "0", "]"}], "\[Equal]", 
                 "r0dao"}]}], "}"}], ",", 
              RowBox[{"{", "r", "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"s", ",", "0", ",", "bianjie"}], "}"}], ",", 
              RowBox[{"WorkingPrecision", "->", "jingdu"}], ",", 
              RowBox[{"PrecisionGoal", "->", "15"}], ",", 
              RowBox[{"AccuracyGoal", "->", "15"}], ",", 
              RowBox[{"MaxSteps", "->", "Infinity"}]}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"solx", ",", "dians"}], "}"}], "=", 
          RowBox[{
           RowBox[{"NDSolve", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"x", "''"}], "[", "s", "]"}], "+", 
                 RowBox[{"x", "[", "s", "]"}], "-", " ", 
                 RowBox[{
                  RowBox[{"can1", "[", "s", "]"}], "*", 
                  RowBox[{"(", 
                   RowBox[{"1", "-", 
