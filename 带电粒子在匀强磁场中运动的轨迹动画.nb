Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pos", ",", 
      RowBox[{"{", 
       RowBox[{"{", "points", "}"}], "}"}]}], "}"}], "=", 
    RowBox[{
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"m", "*", 
           RowBox[{
            RowBox[{"x", "''"}], "[", "t", "]"}]}], "\[Equal]", 
          RowBox[{"q", "*", "B", "*", 
           RowBox[{
            RowBox[{"y", "'"}], "[", "t", "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"m", "*", 
           RowBox[{
            RowBox[{"y", "''"}], "[", "t", "]"}]}], "\[Equal]", 
          RowBox[{
           RowBox[{"-", "q"}], "*", "B", "*", 
           RowBox[{
            RowBox[{"x", "'"}], "[", "t", "]"}]}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"x", "'"}], "[", "0", "]"}], "\[Equal]", 
          RowBox[{
           SubscriptBox["v", "0"], "*", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"y", "'"}], "[", "0", "]"}], "\[Equal]", 
          RowBox[{
           SubscriptBox["v", "0"], "*", 
           RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"x", "[", "0", "]"}], "\[Equal]", 
          SubscriptBox["x", "0"]}], ",", 
         RowBox[{
          RowBox[{"y", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
         RowBox[{"WhenEvent", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"y", "[", "t", "]"}], "<", "0"}], ",", 
             RowBox[{
              RowBox[{"x", "[", "t", "]"}], "<", "0"}], ",", 
             RowBox[{
              RowBox[{"y", "[", "t", "]"}], ">", "8"}], ",", 
             RowBox[{
              RowBox[{"x", "[", "t", "]"}], ">", "8"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"x", "'"}], "[", "t", "]"}], ",", 
                RowBox[{
                 RowBox[{"y", "'"}], "[", "t", "]"}]}], "}"}], "\[Rule]", 
              RowBox[{"{", 
               RowBox[{"0", ",", "0"}], "}"}]}], ",", 
             RowBox[{"Sow", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"x", "[", "t", "]"}], ",", 
                RowBox[{"y", "[", "t", "]"}]}], "}"}], "]"}]}], "}"}]}], 
          "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", 
         SubscriptBox["t", "2"]}], "}"}]}], "]"}], "//", "Reap"}]}], ",", 
