 RowBox[{
  RowBox[{"F", "[", 
   RowBox[{"\[Alpha]_", ",", "\[Beta]_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"BesselJ", "[", 
    RowBox[{"0", ",", 
     RowBox[{"r2", " ", "\[Alpha]"}]}], "]"}], "+", 
   RowBox[{"\[Beta]", " ", 
    RowBox[{"BesselY", "[", 
     RowBox[{"0", ",", 
      RowBox[{"r2", " ", "\[Alpha]"}]}], "]"}]}]}]}], "\n", 
 RowBox[{"solutions", "=", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"\[Alpha]", ",", "\[Beta]"}], "]"}], "\[Equal]", "0"}], ",", 
      RowBox[{
       RowBox[{"F", "[", 
