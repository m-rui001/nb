Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{"3", "/", "4"}]], " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", "r2", " ", "\[Alpha]"}]], " ", 
     SqrtBox[
      RowBox[{"r1", " ", "r2"}]], " ", 
     RowBox[{"Cos", "[", 
      RowBox[{
       FractionBox["\[Pi]", "4"], "+", 
       RowBox[{"r1", " ", "\[Alpha]"}]}], "]"}]}], 
    RowBox[{"\[Pi]", " ", "r1", " ", "r2", " ", "\[Alpha]"}]]}], "+", 
  FractionBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"1", "/", "4"}]], " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"\[ImaginaryI]", " ", "r2", " ", "\[Alpha]"}]], " ", 
    SqrtBox[
     RowBox[{"r1", " ", "r2"}]], " ", 
    RowBox[{"Cos", "[", 
     RowBox[{
      FractionBox["\[Pi]", "4"], "+", 
      RowBox[{"r1", " ", "\[Alpha]"}]}], "]"}]}], 
   RowBox[{"\[Pi]", " ", "r1", " ", "r2", " ", "\[Alpha]"}]], "+", 
  FractionBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"1", "/", "4"}]], " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", "r1", " ", "\[Alpha]"}]], " ", 
    SqrtBox[
     RowBox[{"r1", " ", "r2"}]], " ", 
    RowBox[{"Cos", "[", 
     RowBox[{
