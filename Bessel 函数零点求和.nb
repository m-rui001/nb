Cell[BoxData[{
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"\[Alpha]_", ",", "\[Beta]_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"BesselJ", "[", 
    RowBox[{"1", ",", 
     RowBox[{"r1", " ", "\[Alpha]"}]}], "]"}], "+", 
   RowBox[{"\[Beta]", " ", 
    RowBox[{"BesselY", "[", 
