    RowBox[{"{", 
     RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}]}], "]"}]}], "\n", 
 RowBox[{"Ai", "=", 
  RowBox[{"\[Alpha]", "/.", "\[VeryThinSpace]", "solutions"}]}], "\n", 
 RowBox[{"Bi", "=", 
  RowBox[{"\[Beta]", "/.", "\[VeryThinSpace]", "solutions"}]}], "\n", 
 RowBox[{
  RowBox[{"h", "[", 
   RowBox[{"Xi_", ",", "Yi_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", " ", 
       RowBox[{
        SubsuperscriptBox["\[Integral]", "2.25", "10.1258"], 
        RowBox[{
         RowBox[{"r", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"BesselJ", "[", 
             RowBox[{"0", ",", 
              RowBox[{"Xi", " ", "r"}]}], "]"}], "+", 
            RowBox[{"Yi", " ", 
             RowBox[{"BesselY", "[", 
              RowBox[{"0", ",", 
               RowBox[{"Xi", " ", "r"}]}], "]"}]}]}], ")"}], " ", "30", " ", 
          RowBox[{"Log", "[", 
           FractionBox["10.1258", "2.25"], "]"}]}], 
         RowBox[{"\[DifferentialD]", "r"}]}]}]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"BesselJ", "[", 
        RowBox[{"0", ",", 
         RowBox[{"2.25", " ", "Xi"}]}], "]"}], "+", 
       RowBox[{"Yi", " ", 
        RowBox[{"BesselY", "[", 
         RowBox[{"0", ",", 
          RowBox[{"2.25", " ", "Xi"}]}], "]"}]}]}], ")"}], " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{
         SuperscriptBox["Xi", "2"], " ", "t", " ", "8"}], 
        SuperscriptBox["10", "8"]]}]]}], ")"}], "/", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      SuperscriptBox["10.1258", "2"], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"BesselJ", "[", 
          RowBox[{"1", ",", 
           RowBox[{"10.1258", " ", "Xi"}]}], "]"}], "+", 
         RowBox[{"Yi", " ", 
          RowBox[{"BesselY", "[", 
           RowBox[{"1", ",", 
            RowBox[{"10.1258", " ", "Xi"}]}], "]"}]}]}], ")"}], "2"]}], "-", 
     RowBox[{
      SuperscriptBox["2.25", "2"], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"BesselJ", "[", 
          RowBox[{"0", ",", 
           RowBox[{"2.25", " ", "Xi"}]}], "]"}], "+", 
         RowBox[{"Yi", " ", 
          RowBox[{"BesselY", "[", 
           RowBox[{"0", ",", 
            RowBox[{"2.25", " ", "Xi"}]}], "]"}]}]}], ")"}], "2"]}]}], 
    ")"}]}]}], "\n", 
 RowBox[{
  RowBox[{"g", "[", 
   RowBox[{"Ai_", ",", "Bi_"}], "]"}], ":=", 
  RowBox[{
   UnderoverscriptBox["\[Sum]", 
    RowBox[{"n", "=", "1"}], 
    RowBox[{"Length", "[", "Ai", "]"}]], 
   RowBox[{"h", "[", 
    RowBox[{
     RowBox[{"Ai", "[", "n", "]"}], ",", 
     RowBox[{"Bi", "[", "n", "]"}]}], "]"}]}]}], "\n", 
 RowBox[{"result", "=", 
  RowBox[{"g", "[", 
   RowBox[{"Ai", ",", "Bi"}], "]"}]}]}], "Input",
