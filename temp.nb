3831c495b0db"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"J", "[", 
    RowBox[{"i_", ",", "j_", ",", "x_"}], "]"}], "=", 
   RowBox[{"sol", "[", 
    RowBox[{"i", ",", "j", ",", "x"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"J", "[", 
  RowBox[{"1", ",", "4", ",", "a"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"I", " ", "wish", " ", "to"}], " ", "*)"}]}]}], "Input",
