      RowBox[{"Style", "[", 
       RowBox[{
        TagBox["\"\<s (m)\>\"",
         HoldForm], ",", "Black"}], "]"}], ",", 
      RowBox[{"Style", "[", 
       RowBox[{
        TagBox["\"\<r\>\"",
         HoldForm], ",", "Black"}], "]"}]}], "}"}]}], ",", 
