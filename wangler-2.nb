Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "\"\<`*\>\"", "]"}], ";", 
  RowBox[{"jingdu", "=", "50"}], ";", 
  RowBox[{
   RowBox[{"fxyzyan", "[", 
    RowBox[{"huatu_", ",", 
     RowBox[{"r0_", "?", "NumberQ"}], ",", 
     RowBox[{"r0dao_", "?", "NumberQ"}], ",", 
     RowBox[{"xxiao0_", "?", "NumberQ"}], ",", 
     RowBox[{"xxiao0dao_", "?", "NumberQ"}], ",", 
     RowBox[{"bianjie_", ":", "10"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Eta]", "=", 
        FractionBox["1", "2"]}], ",", "r", ",", "x", ",", "zhong", ",", "rhh",
        ",", "jieguo", ",", "tu", ",", "can1", ",", "can2", ",", "can3", ",", 
       "solx", ",", "dians"}], "}"}], ",", 
     RowBox[{
      RowBox[{"r", "=", 
       RowBox[{"r", "/.", 
        RowBox[{
         RowBox[{"NDSolve", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"r", "''"}], "[", "s", "]"}], "+", 
               RowBox[{"r", "[", "s", "]"}], "-", 
               FractionBox[
                SuperscriptBox["\[Eta]", "2"], 
                SuperscriptBox[
                 RowBox[{"r", "[", "s", "]"}], "3"]], "-", 
               FractionBox[
                RowBox[{"1", "-", 
                 SuperscriptBox["\[Eta]", "2"]}], 
                RowBox[{"r", "[", "s", "]"}]]}], "\[Equal]", "0"}], ",", 
             RowBox[{
              RowBox[{"r", "[", "0", "]"}], "\[Equal]", "r0"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"r", "'"}], "[", "0", "]"}], "\[Equal]", "r0dao"}]}], 
            "}"}], ",", 
           RowBox[{"{", "r", "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"s", ",", "0", ",", "bianjie"}], "}"}], ",", 
           RowBox[{"WorkingPrecision", "->", "jingdu"}], ",", 
           RowBox[{"PrecisionGoal", "->", "15"}], ",", 
           RowBox[{"AccuracyGoal", "->", "15"}], ",", 
           RowBox[{"MaxSteps", "->", "Infinity"}]}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"solx", ",", "dians"}], "}"}], "=", 
       RowBox[{
        RowBox[{"NDSolve", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"x", "''"}], "[", "s", "]"}], "+", 
              RowBox[{"x", "[", "s", "]"}], "-", " ", 
              RowBox[{
               RowBox[{"can1", "[", "s", "]"}], "*", 
               RowBox[{"(", 
                RowBox[{"1", "-", 
                 SuperscriptBox["\[Eta]", "2"]}], ")"}]}]}], "==", "0"}], ",", 
            RowBox[{
             RowBox[{"x", "[", "0", "]"}], "==", "xxiao0"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"x", "'"}], "[", "0", "]"}], "==", "xxiao0dao"}], ",", 
            RowBox[{
             RowBox[{"can1", "[", "0", "]"}], "==", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"And", "@@", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Abs", "[", 
                   RowBox[{"x", "[", "0", "]"}], "]"}], "<", 
                  RowBox[{"Abs", "[", 
                   RowBox[{"r", "[", "0", "]"}], "]"}]}], "}"}]}], ",", 
               RowBox[{
                FractionBox[
                 RowBox[{"x", "[", "0", "]"}], 
                 SuperscriptBox[
                  RowBox[{"r", "[", "0", "]"}], "2"]], "/.", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"x", "[", "0", "]"}], "->", "xxiao0"}], "}"}]}], 
               ",", 
               RowBox[{
                FractionBox["1", 
                 RowBox[{"x", "[", "0", "]"}]], "/.", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"x", "[", "0", "]"}], "->", "xxiao0"}], "}"}]}]}], 
              "]"}]}], ",", 
            RowBox[{"WhenEvent", "[", 
             RowBox[{
              RowBox[{"And", "@@", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Abs", "[", 
                   RowBox[{"Re", "@", 
                    RowBox[{"x", "[", "s", "]"}]}], "]"}], "-", 
                  RowBox[{"Abs", "[", 
                   RowBox[{"Re", "@", 
                    RowBox[{"r", "[", "s", "]"}]}], "]"}]}], "<", "0"}], 
                "}"}]}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"can1", "[", "s", "]"}], "->", 
                FractionBox[
                 RowBox[{"x", "[", "s", "]"}], 
                 SuperscriptBox[
                  RowBox[{"r", "[", "s", "]"}], "2"]]}], "}"}], ",", 
              RowBox[{
              "\"\<LocationMethod\>\"", "\[Rule]", "\"\<Brent\>\""}]}], "]"}],
             ",", "\[IndentingNewLine]", 
            RowBox[{"WhenEvent", "[", 
             RowBox[{
              RowBox[{"And", "@@", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Abs", "[", 
                   RowBox[{"Re", "@", 
                    RowBox[{"x", "[", "s", "]"}]}], "]"}], "-", 
                  RowBox[{"Abs", "[", 
                   RowBox[{"Re", "@", 
                    RowBox[{"r", "[", "s", "]"}]}], "]"}]}], ">=", "0"}], 
                "}"}]}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"can1", "[", "s", "]"}], "->", 
                FractionBox["1", 
                 RowBox[{"x", "[", "s", "]"}]]}], "}"}], ",", 
              RowBox[{
              "\"\<LocationMethod\>\"", "\[Rule]", "\"\<Brent\>\""}]}], "]"}],
             ",", "\[IndentingNewLine]", 
            RowBox[{"WhenEvent", "[", 
             RowBox[{
              RowBox[{"And", "@@", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Abs", "[", 
                   RowBox[{"Re", "@", 
                    RowBox[{"x", "[", "s", "]"}]}], "]"}], "-", 
                  RowBox[{"Abs", "[", 
                   RowBox[{"Re", "@", 
                    RowBox[{"r", "[", "s", "]"}]}], "]"}]}], "<", "0"}], 
                "}"}]}], ",", 
              RowBox[{"Sow", "[", 
               RowBox[{"{", 
                RowBox[{"s", ",", 
                 RowBox[{"r", "[", "s", "]"}], ",", 
                 RowBox[{"x", "[", "s", "]"}]}], "}"}], "]"}], ",", 
              RowBox[{
              "\"\<LocationMethod\>\"", "\[Rule]", "\"\<Brent\>\""}]}], 
             "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", 
            RowBox[{"can1", "[", "s", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", "0", ",", "bianjie"}], "}"}], ",", 
          RowBox[{"DiscreteVariables", "->", 
           RowBox[{"{", 
            RowBox[{"can1", "[", "s", "]"}], "}"}]}], ",", 
          RowBox[{"MaxSteps", "\[Rule]", "\[Infinity]"}], ",", 
          RowBox[{"InterpolationOrder", "->", "4"}]}], "]"}], "//", 
        "Reap"}]}], ";", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"rn0", ",", "xnewn0", ",", "can1new"}], "}"}], "=", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"r", ",", "x", ",", 
          RowBox[{"can1", "[", "s", "]"}]}], "}"}], "/.", 
        RowBox[{"solx", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}]}], 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bianjie", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"fxyzyan", "[", 
  RowBox[{"0", ",", 
   FractionBox["62", "100"], ",", "0", ",", 
   FractionBox["77", "100"], ",", "0", ",", "bianjie"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"rn0", "[", "s", "]"}], ",", 
     RowBox[{"xnewn0", "[", "s", "]"}], ",", 
     RowBox[{"-", 
      RowBox[{"rn0", "[", "s", "]"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"s", ",", "0", ",", "bianjie"}], "}"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
   RowBox[{"PlotLegends", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<r\>\"", ",", "\"\<x\>\""}], "}"}]}], ",", 
