     RowBox[{"Thick", ",", "Italic"}], "]"}]}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"ReImPlot", "[", 
  RowBox[{
   RowBox[{"{", "can1new", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"s", ",", "0", ",", "bianjie"}], "}"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}], "Input",
