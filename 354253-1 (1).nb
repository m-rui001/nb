Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"g", "=", "9.8"}], ",", 
     RowBox[{"l", "=", "1"}], ",", 
     RowBox[{"\[Theta]0", "=", 
      RowBox[{"\[Pi]", "/", "2"}]}], ",", 
     RowBox[{"time", "=", "10"}]}], "}"}], ",", 
   RowBox[{"Manipulate", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"sol", ",", "\[Theta]"}], "}"}], ",", 
       RowBox[{
        RowBox[{"sol", "=", 
         RowBox[{"NDSolve", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"g", " ", 
               RowBox[{"Sin", "[", 
                RowBox[{"\[Theta]", "[", "t", "]"}], "]"}]}], "\[Equal]", 
              RowBox[{
               RowBox[{"-", "l"}], " ", 
               RowBox[{
                RowBox[{"\[Theta]", "''"}], "[", "t", "]"}]}]}], ",", 
             RowBox[{
              RowBox[{"\[Theta]", "[", "0", "]"}], "\[Equal]", "\[Theta]0"}], 
             ",", 
             RowBox[{
              RowBox[{
               RowBox[{"\[Theta]", "'"}], "[", "0", "]"}], "\[Equal]", 
              "\[Omega]0"}]}], "}"}], ",", "\[Theta]", ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "time"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"\[Theta]", "=", 
         RowBox[{"\[Theta]", "/.", " ", 
          RowBox[{"sol", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Plot", "[", 
           RowBox[{
            RowBox[{"\[Theta]", "[", "t", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "0", ",", "time"}], "}"}], ",", 
            RowBox[{"AxesLabel", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"\"\<t/s\>\"", ",", "\"\<\[Theta]/rad\>\""}], "}"}]}]}],
            "]"}], ",", 
          RowBox[{"ParametricPlot", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\[Theta]", "[", "t", "]"}], ",", 
              RowBox[{
               RowBox[{"\[Theta]", "'"}], "[", "t", "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "0", ",", "time"}], "}"}], ",", 
            RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
            RowBox[{"AxesLabel", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"\"\<\[Theta]\>\"", ",", "\"\<\[Theta]'\>\""}], "}"}]}],
             ",", 
            RowBox[{"AspectRatio", "\[Rule]", 
             RowBox[{"1", "/", "2"}]}]}], "]"}]}], "}"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Omega]0", ",", "4.3", ",", "4.5", ",", "0.01"}], "}"}], ",", 
     RowBox[{"SaveDefinitions", "\[Rule]", "True"}]}], "]"}]}], "]"}], "\n", 
 RowBox[{
  RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "Input",
