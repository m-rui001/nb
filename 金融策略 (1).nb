Cell[BoxData[
 RowBox[{
  RowBox[{"qiujie", "=", " ", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"profit", ",", "var"}], "}"}], ",", 
     RowBox[{
      RowBox[{"firstor", "=", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"profit", ",", "var"}], "]"}], "//", "FullSimplify"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<first order derivative is \>\"", ",", "firstor"}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"equal", "=", 
       RowBox[{
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{"firstor", "\[Equal]", "0"}], ",", "var"}], "]"}], "//", 
        "FullSimplify"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<optimal solution is \>\"", ",", " ", "equal"}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"seconder", "=", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"profit", ",", 
          RowBox[{"{", 
           RowBox[{"var", ",", "2"}], "}"}]}], "]"}], "//", 
        "FullSimplify"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<second derivative is \>\"", ",", "seconder"}], "]"}]}]}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9073141092476215`*^9, 3.9073142566561823`*^9}, {
  3.9073143122575493`*^9, 3.9073145342945013`*^9}, {3.9076229525246787`*^9, 
