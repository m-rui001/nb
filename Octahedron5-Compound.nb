Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "Inertia*"}]], "Input",ExpressionUUID->"989aa28f-6a20-43bc-b8bc-e344bcce4aea"],

Cell[BoxData[
 StyleBox["\<\"InertiaTensor[gc, simp1, simp2] computes the moment of inertia \
tensor of the specified GraphicsComplex-specified polyhedron using Gauss's \
law.  InertiaTensor[gc, vol, simp1, simp2] uses the precomputed volume and \
applies simplification functions 1 and 2 at approriate steps.  \
InertiaTensot[ent, simp1, simp2] computes the moment of inertia tensor of the \
specified PolyhedronData object using the given simplification \
functions.\"\>", "MSG"]], "Print", "PrintUsage",
 CellTags->
  "Info3629458046-8204202",ExpressionUUID->"75051d64-b8f5-4977-abd9-\
9fac1dc28d1d"]
}, Open  ]],

