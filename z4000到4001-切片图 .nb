Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"w", "=", "20"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"o", "=", "2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"e", "=", "3"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Lambda]", "=", "0.532"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"k", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"2", "*", "Pi"}], ")"}], "/", "\[Lambda]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"p", "=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{"w", "^", "2"}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", "*", "I", "*", "e", "*", "z"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"k", "*", 
        RowBox[{"o", "^", "2"}]}], ")"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"q", "=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{"w", "^", "2"}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", "*", "I", "*", "z"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"k", "*", "e"}], ")"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"EX", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"w", "^", "4"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"q", "^", "2"}], "*", "x"}], "+", 
         RowBox[{"I", "*", 
          RowBox[{"p", "^", "2"}], "*", "y"}]}], ")"}]}], ")"}], "/", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"p", "*", "q"}], ")"}], "^", "3"}]}], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{"I", "*", "k", "*", "e", "*", "z"}], "]"}], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "^", "2"}], "/", 
         RowBox[{"p", "^", "2"}]}], "+", 
        RowBox[{
         RowBox[{"y", "^", "2"}], "/", 
         RowBox[{"q", "^", "2"}]}]}], ")"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"EY", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"k", "^", "2"}], "*", 
       RowBox[{"o", "^", "2"}], "*", 
       RowBox[{"w", "^", "4"}], "*", 
       RowBox[{"(", 
        RowBox[{"x", "-", 
         RowBox[{"I", "*", "y"}]}], ")"}]}], ")"}], "/", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"k", "*", "o", "*", 
         RowBox[{"w", "^", "2"}]}], "+", 
        RowBox[{"2", "*", "I", "*", "z"}]}], ")"}], "^", "2"}]}], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{"I", "*", "k", "*", "o", "*", "z"}], "]"}], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "k"}], "*", "o", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"x", "^", "2"}], "+", 
          RowBox[{"y", "^", "2"}]}], ")"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"k", "*", "o", "*", 
         RowBox[{"w", "^", "2"}]}], "+", 
        RowBox[{"2", "*", "I", "*", "z"}]}], ")"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"CEX", "=", 
   RowBox[{"Conjugate", "[", "EX", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"CEY", "=", 
    RowBox[{"Conjugate", "[", "EY", "]"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"SA", "=", 
    RowBox[{"Im", "[", 
     RowBox[{"CEX", "*", "EY"}], "]"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"SA", "[", 
   RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{"x", ",", "y", ",", "z", ",", 
    RowBox[{"Im", "[", 
     RowBox[{"CEX", "*", "EY"}], "]"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"jet", "[", 
   RowBox[{"u_", "?", "NumericQ"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Blend", "[", 
    RowBox[{
     RowBox[{"{", 
