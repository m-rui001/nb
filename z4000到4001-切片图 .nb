Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"w", "=", "20"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"o", "=", "2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"e", "=", "3"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Lambda]", "=", "0.532"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"k", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"2", "*", "Pi"}], ")"}], "/", "\[Lambda]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"p", "=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{"w", "^", "2"}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", "*", "I", "*", "e", "*", "z"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"k", "*", 
        RowBox[{"o", "^", "2"}]}], ")"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"q", "=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{"w", "^", "2"}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", "*", "I", "*", "z"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"k", "*", "e"}], ")"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"EX", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"w", "^", "4"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"q", "^", "2"}], "*", "x"}], "+", 
         RowBox[{"I", "*", 
          RowBox[{"p", "^", "2"}], "*", "y"}]}], ")"}]}], ")"}], "/", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"p", "*", "q"}], ")"}], "^", "3"}]}], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{"I", "*", "k", "*", "e", "*", "z"}], "]"}], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "^", "2"}], "/", 
         RowBox[{"p", "^", "2"}]}], "+", 
        RowBox[{
         RowBox[{"y", "^", "2"}], "/", 
         RowBox[{"q", "^", "2"}]}]}], ")"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"EY", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"k", "^", "2"}], "*", 
       RowBox[{"o", "^", "2"}], "*", 
       RowBox[{"w", "^", "4"}], "*", 
       RowBox[{"(", 
        RowBox[{"x", "-", 
         RowBox[{"I", "*", "y"}]}], ")"}]}], ")"}], "/", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"k", "*", "o", "*", 
         RowBox[{"w", "^", "2"}]}], "+", 
        RowBox[{"2", "*", "I", "*", "z"}]}], ")"}], "^", "2"}]}], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{"I", "*", "k", "*", "o", "*", "z"}], "]"}], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "k"}], "*", "o", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"x", "^", "2"}], "+", 
          RowBox[{"y", "^", "2"}]}], ")"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"k", "*", "o", "*", 
         RowBox[{"w", "^", "2"}]}], "+", 
        RowBox[{"2", "*", "I", "*", "z"}]}], ")"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"CEX", "=", 
   RowBox[{"Conjugate", "[", "EX", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"CEY", "=", 
    RowBox[{"Conjugate", "[", "EY", "]"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"SA", "=", 
    RowBox[{"Im", "[", 
     RowBox[{"CEX", "*", "EY"}], "]"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"SA", "[", 
   RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{"x", ",", "y", ",", "z", ",", 
    RowBox[{"Im", "[", 
     RowBox[{"CEX", "*", "EY"}], "]"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"jet", "[", 
   RowBox[{"u_", "?", "NumericQ"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Blend", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"RGBColor", "[", 
          RowBox[{"1", ",", "0", ",", 
           RowBox[{"9", "/", "16"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "9"}], ",", "Blue"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"23", "/", "63"}], ",", "Cyan"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"13", "/", "21"}], ",", "Yellow"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"47", "/", "63"}], ",", "Orange"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"55", "/", "63"}], ",", "Red"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", 
         RowBox[{"RGBColor", "[", 
          RowBox[{
           RowBox[{"1", "/", "2"}], ",", "0", ",", "0"}], "]"}]}], "}"}]}], 
      "}"}], ",", "u"}], "]"}], "/;", 
   RowBox[{
   "0", "\[LessEqual]", "u", "\[LessEqual]", "1"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"Partition", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"SA", "[", 
         RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"-", "33"}], ",", "33", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"y", ",", 
          RowBox[{"-", "28"}], ",", "28", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"z", ",", "4180", ",", "4200", ",", "1"}], "}"}]}], "]"}], "//",
       "Flatten"}], ",", "4"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"leg", "=", 
   RowBox[{"BarLegend", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"jet", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}], ",", 
     RowBox[{"LegendMarkerSize", "\[Rule]", "300"}], ",", 
     RowBox[{"LabelStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"FontFamily", "\[Rule]", "\"\<Times New Roman\>\""}], ",", 
        RowBox[{"FontSize", "\[Rule]", "20"}]}], "}"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListDensityPlot3D", "[", 
  RowBox[{"data", ",", 
   RowBox[{"PlotRange", "\[Rule]", "Full"}], ",", 
   RowBox[{"PlotLegends", "\[Rule]", 
    RowBox[{"Placed", "[", 
     RowBox[{"leg", ",", 
      RowBox[{"{", 
       RowBox[{"After", ",", "Top"}], "}"}]}], "]"}]}], ",", 
   RowBox[{"ImageSize", "\[Rule]", "300"}], ",", 
   RowBox[{"Axes", "\[Rule]", "False"}], ",", 
