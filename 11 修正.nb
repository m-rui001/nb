Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"s", "=", "0.0001"}], ";", "\n", 
    RowBox[{"\[Theta]", "=", "\[Pi]"}], ";", "\n", 
    RowBox[{"\[Alpha]", "=", 
     FractionBox[
      RowBox[{"9", " ", "\[Pi]"}], "8"]}], ";"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"A", "=", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]], " ", 
      RowBox[{"Tan", "[", 
       FractionBox["\[Alpha]", "2"], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     SubscriptBox["X", "1"], "=", 
     RowBox[{
      FractionBox["1", "2"], " ", "s", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Cosh", "[", "r", "]"}], "+", 
        RowBox[{
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]], " ", 
         RowBox[{"Sinh", "[", "r", "]"}]}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     SubscriptBox["X", "2"], "=", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"-", "s"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Cosh", "[", "r", "]"}], "+", 
        RowBox[{
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Theta]"}]], " ", 
         RowBox[{"Sinh", "[", "r", "]"}]}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"NN", "[", "r_", "]"}], "=", 
     RowBox[{
      SqrtBox["2"], " ", 
      RowBox[{"Sinh", "[", "r", "]"}], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", 
            SuperscriptBox[
             RowBox[{"Abs", "[", "A", "]"}], "2"]}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"Sinh", "[", "r", "]"}], "2"], "+", 
            FractionBox[
             SuperscriptBox["s", "2"], "4"]}], ")"}]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", 
            SuperscriptBox[
             RowBox[{"Abs", "[", "A", "]"}], "2"]}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             SubscriptBox["X", "1"], " ", 
             SubscriptBox["X", "2"], " ", 
             RowBox[{"(", 
              RowBox[{"1", "+", 
               RowBox[{"2", " ", 
                SuperscriptBox[
                 RowBox[{"Sinh", "[", "r", "]"}], "2"]}]}], ")"}]}], "-", 
            RowBox[{
             SubsuperscriptBox["X", "2", "2"], " ", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]], " ", 
             RowBox[{"Sinh", "[", "r", "]"}], " ", 
             RowBox[{"Cosh", "[", "r", "]"}]}], "-", 
            RowBox[{
             SubsuperscriptBox["X", "1", "2"], " ", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{
               RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Theta]"}]], " ", 
             RowBox[{"Sinh", "[", "r", "]"}], " ", 
             RowBox[{"Cosh", "[", "r", "]"}]}], "+", 
            SuperscriptBox[
             RowBox[{"Sinh", "[", "r", "]"}], "2"]}], ")"}], " ", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"-", 
             FractionBox["1", "2"]}], " ", 
            SuperscriptBox["s", "2"], " ", 
            SuperscriptBox[
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"Cosh", "[", "r", "]"}], "+", 
               RowBox[{
                SuperscriptBox["\[ExponentialE]", 
                 RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]], " ", 
                RowBox[{"Sinh", "[", "r", "]"}]}]}], "]"}], "2"]}]]}]}], 
        ")"}], 
       RowBox[{"-", 
        FractionBox["1", "2"]}]]}]}], ";"}]}]}]], "Input",
