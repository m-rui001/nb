Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"m", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"List", "[", 
     RowBox[{"1", ",", "1", ",", "1"}], "]"}], "]"}]}], " ", ";", 
  RowBox[{"(*", "\:5355\:4f4d\:77e9\:9635", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"\[Mu]", "=", 
   RowBox[{"\[Mu]r", " ", "m"}]}], ";", 
  RowBox[{"\[Mu]r", "=", "0.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Epsilon]1", "=", "4"}], ";", 
  RowBox[{"\[Epsilon]2", "=", 
   RowBox[{"-", "3"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Gamma]r", "=", "0.5"}], ";", 
  RowBox[{"c", "=", 
   RowBox[{"3", " ", 
    RowBox[{"10", "^", "8"}]}]}], ";", 
  RowBox[{"\[Omega]", "=", 
   RowBox[{"2", "*", "Pi", " ", 
    RowBox[{"10", "^", "9"}], " ", "5"}]}], ";", 
  RowBox[{"(*", "\:6750\:6599\:53c2\:6570", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"\[Epsilon]", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"List", "[", 
     RowBox[{"\[Epsilon]1", ",", "\[Epsilon]1", ",", "\[Epsilon]2"}], "]"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Gamma]", "=", 
   RowBox[{"\[Gamma]r", " ", "m"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Kappa]", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"-", "kz"}], ",", "ky"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"kz", ",", "0", ",", 
       RowBox[{"-", "kx"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "ky"}], ",", "kx", ",", "0"}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"M", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Kappa]", ".", 
       RowBox[{"Inverse", "[", "\[Mu]", "]"}], ".", "\[Kappa]"}], "+", 
      RowBox[{"I", " ", 
       RowBox[{"\[Omega]", "/", "c"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Kappa]", ".", 
          RowBox[{"Inverse", "[", "\[Mu]", "]"}], ".", "\[Gamma]"}], "+", 
         RowBox[{"\[Gamma]", ".", 
          RowBox[{"Inverse", "[", "\[Mu]", "]"}], ".", "\[Kappa]"}]}], 
        ")"}]}], "+", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Omega]", "^", "2"}], "/", 
        RowBox[{"c", "^", "2"}]}], " ", 
       RowBox[{"(", 
        RowBox[{"\[Epsilon]", "-", 
         RowBox[{"\[Gamma]", ".", 
          RowBox[{"Inverse", "[", "\[Mu]", "]"}], ".", "\[Gamma]"}]}], 
        ")"}]}]}], "//", "FullSimplify"}]}], ";"}], 
  RowBox[{"(*", "\:6ce2\:52a8\:65b9\:7a0b", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ContourPlot3D", "[", 
   RowBox[{
