Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"q1", "\[Equal]", 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"3", " ", "t"}], "+", "\[CapitalDelta]11"}]], "+", 
        RowBox[{
         SuperscriptBox["\[ExponentialE]", "t"], " ", "\[Alpha]1"}]}], 
       RowBox[{"1", "+", 
        SuperscriptBox["\[ExponentialE]", 
