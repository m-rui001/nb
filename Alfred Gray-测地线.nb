(* Beginning of Notebook Content *)
Notebook[{

Cell[CellGroupData[{
Cell["Notebook 18", "Title"],

Cell[CellGroupData[{

Cell["N18.0", "Section"],

Cell[TextData[{
 "The main purpose of this notebook is to develop a simple program for \
solving numerically the geodesic equations on a surface.  The program is the \
one that was adapted from the first edition of the book for inclusion in the \
tribute to the author contained in the volume [FeWo].  It enables geodesics \
and geodesic circles to be plotted with comparative ease.  Before turning to \
geodesics, though, we study asymptotic curves in ",
 StyleBox["N18.1",
  FontFamily->"Verdana"],
 " and ",
 StyleBox["N18.2.",
  FontFamily->"Verdana"],
 "  "
}], "Text"],

Cell["\<\
We shall need the following parametrizations, mostly investigated in Notebook \
10.\
\>", "Text"],

Cell["\<\
ellipsoid[a_,b_,c_][u_,v_]:= 
   {a Cos[v]Cos[u], b Cos[v]Sin[u], c Sin[v]}
sphere[a_]:= ellipsoid[a,a,a]
torus[a_,b_,c_][u_,v_]:= 
   {(a+b Cos[v])Cos[u], (a+b Cos[v])Sin[u], c Sin[v]}
circularcone[a_,b_][u_,v_]:= {a v Cos[u], a v Sin[u], b v}
paraboloid[a_,b_][u_,v_]:= {u, v, a u^2 + b v^2}\
\>", "Definition"],

Cell["We shall also investigate geodesics on the surfaces", "Text"],

Cell["\<\
monkeysaddle[u_,v_]:= {u, v, u^3-3 u v^2}
helicoid[a_,b_,c_][u_,v_]:= {a v Cos[u], b v Sin[u], c u}
pseudosphere[a_][u_,v_]:= 
   a{Cos[u]Sin[v], Sin[u]Sin[v], Cos[v]+Log[Tan[v/2]]}\
\>", "Definition"],

Cell["Apart from the package", "Text"],

Cell["<<Graphics`Colors`", "Package"],

Cell[TextData[{
 "options for displays, and other commands are loaded in ",
 StyleBox["N18.0.1.",
  FontFamily->"Verdana"],
 "  These include our usual programs ",
 StyleBox["unitnormal, metric, shape, ",
  FontFamily->"Verdana"],
 "for finding first and second fundamental forms, as well as ",
 StyleBox["gcurv, mcurv, ",
  FontFamily->"Verdana"],
 "for computing curvature. In addition, we load the program ",
 StyleBox["christoffel2",
  FontFamily->"Verdana"],
 " introduced in ",
 StyleBox["N17.3,",
  FontFamily->"Verdana"],
 " and we plot the introductory figure showing the rulings on a cylinder."
}], "Text"],

Cell[CellGroupData[{

Cell["N18.0.1", "Subsection"],

Cell[TextData[{
 "Here again is the command that makes it easy to emphasize space curves.  We \
shall use it below to plot a geodesic circle on the torus and geodesics on \
the pseudosphere.  The command \"highlight\" takes as its first argument the \
name of the vector-valued function defining the space curve.  If no other \
arguments are given it will assign to this curve ",
 StyleBox["Hue[0]",
  FontFamily->"Verdana"],
 " and ",
 StyleBox["Thickness[1/100]. ",
  FontFamily->"Verdana"]
}], "Text"],

Cell["\<\
highlight[\[Alpha]_,h_:1/20, k_:3/200][t_]:= 
   Append[\[Alpha][t],{Hue[h], Thickness[k]}]\
\>", "Definition"],

Cell["\<\
SetOptions[ParametricPlot, 
   Compiled->False, AspectRatio->Automatic, Axes->None,
   PlotRange->All];\
\>", "Package"],

Cell["\<\
SetOptions[ParametricPlot3D, 
   Compiled->False, Axes->None, BoxRatios->Automatic,
   Boxed->False];                 \
\>", "Package"],

Cell["Unprotect[J]; J[{x_,y_}]= {-y,x}; Protect[J]; ", "Definition",
 PageWidth->PaperWidth,
 FontVariations->{"CompatibilityType"->0}],

Cell["Unprotect[L]; L[v_]:= Sqrt[v.v]//Simplify; Protect[L];", "Definition",
 PageWidth->PaperWidth,
 FontVariations->{"CompatibilityType"->0}],

Cell[TextData[{
 StyleBox["$DisplayFunction= Identity;\nUnprotect[S];\n   S",
  CellFrame->True,
  InitializationCell->True],
 "[X__]:= Show[X, DisplayFunction->(Display[$Display,#]&)]\nProtect[S];"
}], "Definition"],

Cell["\<\
Miniprogram for the first fundamental form and Christoffel symbols:\
\>", "Text"],

Cell["\<\
unitnormal[x_][u_, v_] :=
Module[{U,V,xu,xv}, 
   xu = D[x[U, V], U]; 
   xv = D[x[U, V], V]; 
   Nx = Cross[xu, xv] /. {U -> u, V -> v}; 
   Simplify[Nx/L[Nx]]
];\
\>", "Miniprogram",
 PageWidth->PaperWidth,
 FontVariations->{"CompatibilityType"->0}],

Cell[TextData[StyleBox["metric[x_][u_,v_]:= Module[{xu,xv,U,V,si},\n   si= \
Simplify[#]/.{U->u, V->v} &;\n   xu= D[x[U,V],U]; \n   xv= D[x[U,V],V]; \n   \
ee= xu.xu//si;\n   ff=  xu.xv//si;\n   gg= xv.xv//si;\n   {{ee,ff},{ff,gg}}\n\
]",
 AutoGeneratedPackage->None,
 ScreenStyleEnvironment->"Working",
 WindowSize->{1016, 668},
 WindowMargins->{{0, Automatic}, {Automatic, 0}}]], "Miniprogram"],

Cell["\<\
shape[x_][u_,v_]:= 
Module[{xuu,xuv,xvv,U,V},
   Nx= unitnormal[x][u,v];
   si= Simplify[#]/.{U->u, V->v} &;
   xuu= D[x[U,V],U,U];
   xuv= D[x[U,V],U,V];
   xvv= D[x[U,V],V,V];
   eee= xuu.Nx//si;
   fff=   xuv.Nx//si;
   ggg= xvv.Nx//si;
   {{eee,fff}, {fff,ggg}}
]\
\>", "Miniprogram",
 PageWidth->PaperWidth,
 FontVariations->{"CompatibilityType"->0}],

Cell["\<\
gcurv[x_][u_,v_]:= 
Module[{xu,xv,xuu,xuv,xvv,U,V,A,B},
   xu= D[x[U,V],U]; 
   xv= D[x[U,V],V];
   xuu= D[x[U,V],U,U];
   xuv= D[x[U,V],U,V];
   xvv= D[x[U,V],V,V];
   B= Det[{xuu,xu,xv}]Det[{xvv,xu,xv}] - Det[{xuv,xu,xv}]^2;
   A= (xu.xu)(xv.xv)-(xu.xv)^2;  
   Simplify[B/A^2]/.{U->u,V->v}
]\
\>", "Miniprogram",
 FontVariations->{"CompatibilityType"->0}],

Cell["\<\
mcurv[x_][u_,v_]:= 
Module[{xu,xv,xuu,xuv,xvv,U,V,A,B},
   xu= D[x[U,V],U]; 
   xv= D[x[U,V],V];
   xuu= D[x[U,V],U,U];
   xuv= D[x[U,V],U,V];
   xvv= D[x[U,V],V,V];
   B= Det[{xuu,xu,xv}](xv.xv)-2Det[{xuv,xu,xv}](xu.xv)
        +Det[{xvv,xu,xv}](xu.xu);
   A= (xu.xu)(xv.xv)-(xu.xv)^2;  
   Simplify[B/(2A^(3/2))]/.{U->u,V->v}
]\
\>", "Miniprogram",
 FontVariations->{"CompatibilityType"->0}],

Cell[TextData[{
 "christoff2[",
 StyleBox["x_][u_,v_]:= Module[{A},\n   si= Simplify[#]/.{U->u, V->v} &;\n   \
",
  AutoGeneratedPackage->None,
  ScreenStyleEnvironment->"Working",
  WindowSize->{1016, 668},
  WindowMargins->{{0, Automatic}, {Automatic, 0}}],
 StyleBox["xu= D[x[U,V],U]; \n   xv= D[x[U,V],V];",
  FontFamily->"Verdana",
  Background->None],
 StyleBox["\n   ee= xu.xu;\n   ff=  xu.xv;\n   gg= xv.xv;\n   A[1,1,1]=  \
D[ee,V]ff - 2D[ff,U]ff + D[ee,U]gg;\n   A[2,2,2]=  D[gg,V]ee - 2D[ff,V]ff + \
D[gg,U]ff;\n   A[2,1,1]= -D[ee,V]ee + 2D[ff,U]ee - D[ee,U]ff;\n   A[1,2,2]= \
-D[gg,V]ff + 2D[ff,V]gg - D[gg,U]gg;\n   A[1,1,2]=  D[ee,V]gg - D[gg,U]ff;\n  \
 A[2,1,2]= -D[ee,V]ff + D[gg,U]ee;\n   A[i_,2,1]= A[i,1,2];\n   G[i_,j_,k_]:= \
A[i,j,k]/(ee gg - ff^2)/2//si;\n   \
Flatten[Table[G[i,j,k],{i,2},{j,2},{k,j,2}]]\n];",
  AutoGeneratedPackage->None,
  ScreenStyleEnvironment->"Working",
  WindowSize->{1016, 668},
  WindowMargins->{{0, Automatic}, {Automatic, 0}}]
}], "Miniprogram"],

Cell["Here is code for the introductory figure.", "Text"],

Cell["circularcylinder[a_][u_,v_]:={a Cos[u], a Sin[u], v}", "Input",
 InitializationCell->True,
 FontFamily->"Verdana"],

Cell["\<\
cc[u_,v_]:= RotateRight[circularcylinder[1][u,v]]
ParametricPlot3D[cc[u,v], {u,0,2\[Pi]}, {v,0,4}];\
\>", "Input",
 InitializationCell->True,
 FontFamily->"Verdana"],

Cell[TextData[{
 "In the following program, the first entry after",
 StyleBox[" PlotPoints",
  FontFamily->"Verdana"],
 " is chosen so that the surface rulings coincide with the additional \
straight lines."
}], "Text"],

Cell["\<\
Module[{hk,ccc,t,z},
   \[Alpha][u_]= cc[u, #] &;
   \[Alpha]\[Alpha][u_]= highlight[\[Alpha][u], .65]; 
   z[1]= ParametricPlot3D[cc[u,v], {u,0,2\[Pi]}, {v,-2,2},
      PlotPoints->{17,20}, Shading->False];
   \[Alpha]\[Alpha]\[Alpha][v_]:= Table[\[Alpha]\[Alpha][u][v], {u, \[Pi]/2, \
\[Pi], \[Pi]/8}];
   z[2]= ParametricPlot3D[\[Alpha]\[Alpha]\[Alpha][v]//Evaluate, {v, -2,2}];
   S[Array[z,2]]
];  \
\>", "UncaptionedFigure",
 FontFamily->"Verdana"],

