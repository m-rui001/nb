      RowBox[{"[", 
       RowBox[{
        RowBox[{"1", ";;", "3"}], ",", 
        RowBox[{"1", ";;", "3"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ResidualDistance", "=", 
     RowBox[{"Abs", "[", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"column1", "-", "column2"}], ")"}], "^", "2"}], "]"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\:8ba1\:7b97\:65cb\:8f6c\:89d2\:5ea6", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"relativeRot", "=", 
     RowBox[{
      RowBox[{"Transpose", "[", "Rot1", "]"}], ".", "Rot2"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ResidualAngle", "=", 
     RowBox[{"ArcCos", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Tr", "[", "relativeRot", "]"}], "-", "1"}], ")"}], "/", 
       "2"}], "]"}]}], ";", 
    RowBox[{"(*", "\:5f27\:5ea6", "*)"}], "\[IndentingNewLine]", 
    RowBox[{"Err2", "=", 
     RowBox[{"ResidualDistance", "*", "10000"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Err3", "=", 
     RowBox[{"ResidualAngle", "*", "10000"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"totalvalue", "=", 
    RowBox[{"Err2", "+", "Err3", "+", "Flx", "+", "Err"}]}], 
   "\[IndentingNewLine]"}]}]], "Input",
