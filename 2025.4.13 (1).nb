 RowBox[{
  RowBox[{"H3", "=", 
   RowBox[{"2", " ", 
    SuperscriptBox[
     RowBox[{"Abs", "[", "NN", "]"}], "2"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", " ", 
         SuperscriptBox[
          RowBox[{"Abs", "[", "A", "]"}], "2"]}], " ", ")"}], 
       SubscriptBox["V", "1"]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", " ", 
         SuperscriptBox[
          RowBox[{"Abs", "[", "A", "]"}], "2"]}], " ", ")"}], 
       SubscriptBox["V", "2"]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   SubscriptBox["V", "1"], "=", 
   RowBox[{
    RowBox[{"15", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"2", "\[ImaginaryI]", " ", "\[Theta]"}]], 
     SuperscriptBox[
      RowBox[{"Sinh", "[", "r", "]"}], "2"], 
     SuperscriptBox[
      RowBox[{"Cosh", "[", "r", "]"}], "2"]}], "+", 
    RowBox[{"9", 
     FractionBox[
      SuperscriptBox["s", "2"], "2"], 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]], 
     RowBox[{"Sinh", "[", "r", "]"}], 
     RowBox[{"Cosh", "[", "r", "]"}]}], "+", 
    FractionBox[
     SuperscriptBox["s", "4"], "16"]}]}], ";"}], "\[IndentingNewLine]", 
