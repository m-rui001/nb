Cell["\<\
Just looking at that, obviously it' s not going to have an analytic solution. \
 Let' s solve it numerically.\
\>", "Text",
 CellChangeTimes->{{3.8389452639038887`*^9, 
  3.838945287156375*^9}},ExpressionUUID->"4e57e781-2dfb-48b2-aadd-\
78652c60d49d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"soln", "[", 
   RowBox[{"y0_", ",", "vy0_", ",", "xmax_"}], "]"}], ":=", 
  RowBox[{"NDSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ELeqn", ",", 
      RowBox[{
       RowBox[{"y", "[", "0", "]"}], "\[Equal]", "y0"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"y", "'"}], "[", "0", "]"}], "\[Equal]", "vy0"}]}], "}"}], 
    ",", "y", ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "xmax"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8389451722912607`*^9, 3.838945185790814*^9}, {
  3.838945228799735*^9, 3.838945251440291*^9}, {3.838945309743078*^9, 
