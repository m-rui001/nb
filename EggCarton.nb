Cell["\<\
There' s no such thing as \"cheating\", there' s just using the appropriate \
tools.  When using Mathematica, it will smash through calculations, but \
totally ignore any errors you put in the setup. So you need to be careful and \
test limits and known solutions, just like always.\
\>", "Text",
 CellChangeTimes->{{3.8389448200387583`*^9, 
  3.838944928004918*^9}},ExpressionUUID->"5e777124-6aa7-499f-ae52-\
a110b67820d9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"z", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Sin", "[", "x", "]"}], 
   RowBox[{"Sin", "[", "y", "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"D", "[", 
  RowBox[{
   RowBox[{"z", "[", 
    RowBox[{"x", ",", 
     RowBox[{"y", "[", "x", "]"}]}], "]"}], ",", "x"}], "]"}]}], "Input",
 CellChangeTimes->{{3.838944937743258*^9, 3.838944966286982*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"0dfac054-655d-45e3-9d89-a0a650ebecac"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Cos", "[", "x", "]"}], " ", 
   RowBox[{"Sin", "[", 
    RowBox[{"y", "[", "x", "]"}], "]"}]}], "+", 
  RowBox[{
   RowBox[{"Cos", "[", 
    RowBox[{"y", "[", "x", "]"}], "]"}], " ", 
   RowBox[{"Sin", "[", "x", "]"}], " ", 
   RowBox[{
    SuperscriptBox["y", "\[Prime]",
     MultilineFunction->None], "[", "x", "]"}]}]}]], "Output",
 CellChangeTimes->{3.838944966926285*^9, 3.839529351007368*^9, 
  3.846102901645018*^9},
 CellLabel->"Out[2]=",ExpressionUUID->"b5787064-f610-4814-b978-38787ff392b8"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"f", "=", 
  RowBox[{"Sqrt", "[", 
   RowBox[{"1", "+", 
    SuperscriptBox[
     RowBox[{
      RowBox[{"y", "'"}], "[", "x", "]"}], "2"], "+", 
    SuperscriptBox[
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"z", "[", 
        RowBox[{"x", ",", 
         RowBox[{"y", "[", "x", "]"}]}], "]"}], ",", "x"}], "]"}], "2"]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.83894499018743*^9, 3.838945045540216*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"3d9838db-887c-47bd-9651-1ab2493775d7"],

Cell[BoxData[
 SqrtBox[
  RowBox[{"1", "+", 
   SuperscriptBox[
    RowBox[{
     SuperscriptBox["y", "\[Prime]",
      MultilineFunction->None], "[", "x", "]"}], "2"], "+", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", "x", "]"}], " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"y", "[", "x", "]"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"y", "[", "x", "]"}], "]"}], " ", 
       RowBox[{"Sin", "[", "x", "]"}], " ", 
       RowBox[{
        SuperscriptBox["y", "\[Prime]",
         MultilineFunction->None], "[", "x", "]"}]}]}], ")"}], 
    "2"]}]]], "Output",
 CellChangeTimes->{{3.838945018521579*^9, 3.838945046372011*^9}, 
   3.839529354020097*^9, 3.846102904192048*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"035d717e-d6aa-47e5-b00e-2fe97c143396"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ELeqn", "=", 
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"f", ",", 
         RowBox[{
          RowBox[{"y", "'"}], "[", "x", "]"}]}], "]"}], ",", "x"}], "]"}], 
     "-", 
     RowBox[{"D", "[", 
      RowBox[{"f", ",", 
       RowBox[{"y", "[", "x", "]"}]}], "]"}]}], "]"}], "\[Equal]", 
   "0"}]}]], "Input",
 CellChangeTimes->{{3.838945054038645*^9, 3.838945064988885*^9}, {
  3.838945107192593*^9, 3.838945131440027*^9}, {3.838945162693256*^9, 
  3.838945165440009*^9}, {3.838945205541815*^9, 3.838945221952433*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"9bd80a37-8da9-468c-a18f-e8bb29594735"],

Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{
    RowBox[{
     RowBox[{"-", "2"}], " ", 
     SuperscriptBox[
      RowBox[{"Sin", "[", "x", "]"}], "2"], " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"2", " ", 
       RowBox[{"y", "[", "x", "]"}]}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"3", "+", 
       RowBox[{"Cos", "[", 
        RowBox[{"2", " ", 
         RowBox[{"y", "[", "x", "]"}]}], "]"}]}], ")"}], " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"2", " ", "x"}], "]"}], " ", 
     RowBox[{
      SuperscriptBox["y", "\[Prime]",
       MultilineFunction->None], "[", "x", "]"}]}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"3", "+", 
       RowBox[{"Cos", "[", 
        RowBox[{"2", " ", "x"}], "]"}]}], ")"}], " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"2", " ", 
       RowBox[{"y", "[", "x", "]"}]}], "]"}], " ", 
     SuperscriptBox[
      RowBox[{
       SuperscriptBox["y", "\[Prime]",
        MultilineFunction->None], "[", "x", "]"}], "2"]}], "+", 
    RowBox[{"4", " ", 
     RowBox[{"Cos", "[", "x", "]"}], " ", 
     RowBox[{"Sin", "[", "x", "]"}], " ", 
     SuperscriptBox[
      RowBox[{"Sin", "[", 
       RowBox[{"y", "[", "x", "]"}], "]"}], "2"], " ", 
     SuperscriptBox[
      RowBox[{
       SuperscriptBox["y", "\[Prime]",
        MultilineFunction->None], "[", "x", "]"}], "3"]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"6", "-", 
       RowBox[{"2", " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"2", " ", "x"}], "]"}], " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"2", " ", 
          RowBox[{"y", "[", "x", "]"}]}], "]"}]}]}], ")"}], " ", 
     RowBox[{
      SuperscriptBox["y", "\[Prime]\[Prime]",
       MultilineFunction->None], "[", "x", "]"}]}]}], 
   RowBox[{"4", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", 
       SuperscriptBox[
        RowBox[{
         SuperscriptBox["y", "\[Prime]",
          MultilineFunction->None], "[", "x", "]"}], "2"], "+", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Cos", "[", "x", "]"}], " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"y", "[", "x", "]"}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"Cos", "[", 
            RowBox[{"y", "[", "x", "]"}], "]"}], " ", 
           RowBox[{"Sin", "[", "x", "]"}], " ", 
           RowBox[{
            SuperscriptBox["y", "\[Prime]",
             MultilineFunction->None], "[", "x", "]"}]}]}], ")"}], "2"]}], 
      ")"}], 
     RowBox[{"3", "/", "2"}]]}]], "\[Equal]", "0"}]], "Output",
 CellChangeTimes->{
