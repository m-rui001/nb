Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"a", "[", "n_", "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"i", "-", "j"}], "\[NotEqual]", 
        RowBox[{"-", "1"}]}], ",", "0", ",", 
       SqrtBox["j"]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", 
       RowBox[{"n", "-", "1"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "0", ",", 
       RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"adagger", "[", "n_", "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"i", "-", "j"}], "\[NotEqual]", "1"}], ",", "0", ",", 
       SqrtBox["i"]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", 
       RowBox[{"n", "-", "1"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "0", ",", 
       RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"initilize", "[", "dimention_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Sigma]1", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}]}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\[Sigma]2", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"ids", "=", 
        RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ",", 
       RowBox[{"idb", "=", 
        RowBox[{"1.0", 
         RowBox[{"IdentityMatrix", "[", "dimention", "]"}]}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"idQ", "=", 
       RowBox[{"1.0", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"ids", ",", "idb"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"b", "=", 
       RowBox[{"1.0", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"ids", ",", 
          RowBox[{"a", "[", "dimention", "]"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"bd", "=", 
       RowBox[{"1.0", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"ids", ",", 
          RowBox[{"adagger", "[", "dimention", "]"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Sigma]p", "=", 
       RowBox[{"1.0", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"\[Sigma]1", ",", "idb"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Sigma]m", "=", 
       RowBox[{"1.0", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"\[Sigma]2", ",", "idb"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Sigma]z", "=", 
       RowBox[{"1.0", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"PauliMatrix", "[", "3", "]"}], ",", "idb"}], "]"}]}]}], 
      ";"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
