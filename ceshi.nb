Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "Ip", ",", "nat", ",", "wz", ",", "sxp", ",", "sxp2", ",", "sxp3", ",", 
     "sxp4", ",", "sxp6", ",", "sxp7", ",", "sxp7b", ",", "sxp7c", ",", 
     "Ipout", ",", "Re\[CapitalOmega]pout", ",", "Is", ",", "wp", ",", 
     "\[CapitalDelta]p", ",", "\[CapitalOmega]m10", ",", "Grr", ",", "Om", 
     ",", "\[CapitalOmega]pout", ",", "\[CapitalOmega]signal", ",", 
     "\[CapitalOmega]m", ",", "sxp6b", ",", "\[CapitalOmega]m20", ",", 
     "\[CapitalOmega]mw1", ",", "\[CapitalOmega]s"}], "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sxp", "[", 
     RowBox[{"Ip_", ",", "nat_", ",", "wz_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Ipout", "=", "Ip"}], ",", 
        RowBox[{"zz", "=", 
         RowBox[{
          RowBox[{"-", "1.5"}], "wz"}]}], ",", 
        RowBox[{"Deltazz", "=", 
         RowBox[{"wz", "/", "20"}]}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"zz", "<", 
           RowBox[{"(", 
            RowBox[{"1.5", "wz"}], ")"}]}], ")"}], ",", 
         RowBox[{
          RowBox[{"Ipout", "=", 
           RowBox[{"Ipout", "-", 
            RowBox[{"Deltazz", "*", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{
               RowBox[{"-", "2"}], 
               RowBox[{
                SuperscriptBox["zz", "2"], "/", 
                SuperscriptBox["wz", "2"]}]}]], "*", "nat", "*", "\[Gamma]2", 
             "*", 
             SuperscriptBox["10", "9"], "*", "h", "*", 
             RowBox[{"c", "/", 
              RowBox[{"(", "\[Lambda]p", ")"}]}], "*", 
             RowBox[{"Re", "[", "\[Rho]2S", "]"}]}]}]}], ";", 
          RowBox[{"\[CapitalOmega]p", "=", 
           RowBox[{"\[Gamma]2", 
            SqrtBox[
             FractionBox["Ipout", 
              RowBox[{"2", " ", "Is"}]]]}]}], ";", 
          RowBox[{"zz", "=", 
           RowBox[{"zz", "+", "Deltazz"}]}]}]}], "]"}], ";", "Ipout"}]}], 
     "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sxp3", "[", 
     RowBox[{"Ip_", ",", "nat_", ",", "wz_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Ipout", "=", "Ip"}], ",", 
        RowBox[{"zz", "=", 
         RowBox[{
          RowBox[{"-", "1.5"}], "wz"}]}], ",", 
        RowBox[{"Deltazz", "=", 
         RowBox[{"wz", "/", "40"}]}], ",", 
        RowBox[{"\[CapitalOmega]pout", "=", 
         RowBox[{"\[Gamma]2", "*", 
          SuperscriptBox["10", "9"], 
          SqrtBox[
           FractionBox["Ip", 
            RowBox[{"2", " ", "Is"}]]]}]}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"zz", "<", 
           RowBox[{"(", 
            RowBox[{"1.5", "wz"}], ")"}]}], ")"}], ",", 
         RowBox[{
          RowBox[{"\[CapitalOmega]p", "=", 
           RowBox[{"\[CapitalOmega]pout", "/", 
            SuperscriptBox["10", "9"]}]}], ";", 
          RowBox[{"\[CapitalOmega]pout", "=", 
           RowBox[{"\[CapitalOmega]pout", "-", 
            RowBox[{"Deltazz", "*", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{
               RowBox[{"-", "2"}], 
               RowBox[{
                SuperscriptBox["zz", "2"], "/", 
                SuperscriptBox["wz", "2"]}]}]], "*", "nat", "*", 
             FractionBox[
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"\[Gamma]2", "*", 
                 SuperscriptBox["10", "9"]}], ")"}], "2"], 
              RowBox[{"4", " ", "Is"}]], "*", 
             FractionBox[
              RowBox[{"h", "*", "c"}], "\[Lambda]p"], "*", 
             "Im\[Rho]12S"}]}]}], ";", 
          RowBox[{"zz", "=", 
           RowBox[{"zz", "+", "Deltazz"}]}]}]}], "]"}], ";", 
       RowBox[{"Ipout", "=", 
        RowBox[{"2", " ", "Is", 
         FractionBox[
          RowBox[{" ", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Abs", "[", "\[CapitalOmega]pout", "]"}], "/", 
              SuperscriptBox["10", "9"]}], ")"}], "2"]}], 
          SuperscriptBox["\[Gamma]2", "2"]]}]}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sxp4", "[", 
     RowBox[{"Ip_", ",", "nat_", ",", "wz_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Ipout", "=", "Ip"}], ",", 
        RowBox[{"zz", "=", 
         RowBox[{
          RowBox[{"-", "1.5"}], "wz"}]}], ",", 
        RowBox[{"Deltazz", "=", 
         RowBox[{"wz", "/", "40"}]}], ",", 
        RowBox[{"\[CapitalOmega]pout", "=", 
         RowBox[{"\[Gamma]2", "*", 
          SuperscriptBox["10", "9"], 
          SqrtBox[
           FractionBox["Ip", 
            RowBox[{"2", " ", "Is"}]]]}]}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"zz", "<", 
           RowBox[{"(", 
            RowBox[{"1.5", "wz"}], ")"}]}], ")"}], ",", 
         RowBox[{
          RowBox[{"\[CapitalOmega]p", "=", 
           RowBox[{"\[CapitalOmega]pout", "/", 
            SuperscriptBox["10", "9"]}]}], ";", 
          RowBox[{"\[CapitalOmega]L", "=", "0"}], ";", 
          RowBox[{"\[CapitalOmega]pout", "=", 
           RowBox[{"\[CapitalOmega]pout", "-", 
            RowBox[{"Deltazz", "*", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{
               RowBox[{"-", "2"}], 
               RowBox[{
                SuperscriptBox["zz", "2"], "/", 
                SuperscriptBox["wz", "2"]}]}]], "*", "nat", "*", 
             RowBox[{"(", 
              RowBox[{"\[Gamma]2", "*", 
               SuperscriptBox["10", "9"]}], ")"}], "*", 
             FractionBox[
              RowBox[{"6", "\[Pi]"}], "2"], "*", 
             SuperscriptBox[
              RowBox[{"(", 
               FractionBox["\[Lambda]p", 
                RowBox[{"2", "\[Pi]"}]], ")"}], "2"], "*", 
             RowBox[{"(", 
              RowBox[{"Im\[Rho]12S", " ", "+", 
               RowBox[{"\[ImaginaryI]", " ", "Re\[Rho]12S"}]}], ")"}]}]}]}], 
          ";", 
          RowBox[{"zz", "=", 
           RowBox[{"zz", "+", "Deltazz"}]}]}]}], "]"}], ";", 
       RowBox[{"Ipout", "=", 
        RowBox[{"2", " ", "Is", 
         FractionBox[
          RowBox[{" ", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Abs", "[", "\[CapitalOmega]pout", "]"}], "/", 
              SuperscriptBox["10", "9"]}], ")"}], "2"]}], 
          SuperscriptBox["\[Gamma]2", "2"]]}]}]}]}], "]"}]}], "\n", 
   RowBox[{
    RowBox[{"sxp6", "[", 
     RowBox[{"Ip_", ",", "nat_", ",", "wz_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Iout", ",", 
        RowBox[{"zz", "=", 
         RowBox[{
          RowBox[{"-", "1.5"}], "wz"}]}], ",", 
        RowBox[{"Deltazz", "=", 
         RowBox[{"wz", "/", "30"}]}], ",", 
        RowBox[{"\[CapitalOmega]pout", "=", 
         RowBox[{"\[Gamma]2", "*", 
          SuperscriptBox["10", "9"], 
          SqrtBox[
           FractionBox["Ip", 
            RowBox[{"2", " ", "Is"}]]]}]}], ",", 
        RowBox[{"\[CapitalOmega]LSignal", "=", "0"}], ",", "IpSignal"}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"zz", "<", 
           RowBox[{"(", 
            RowBox[{"1.5", "wz"}], ")"}]}], ")"}], ",", 
         RowBox[{
          RowBox[{"\[CapitalOmega]p", "=", 
           RowBox[{"\[CapitalOmega]pout", "/", 
            SuperscriptBox["10", "9"]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"\[CapitalOmega]L", "=", 
           RowBox[{"\[CapitalOmega]LSignal", "/", 
            SuperscriptBox["10", "9"]}]}], ";", 
          RowBox[{"\[CapitalOmega]pout", "=", 
           RowBox[{"\[CapitalOmega]pout", "-", 
            RowBox[{"Deltazz", "*", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{
               RowBox[{"-", "2"}], 
               RowBox[{
                SuperscriptBox["zz", "2"], "/", 
                SuperscriptBox["wz", "2"]}]}]], "*", "nat", "*", 
             RowBox[{"(", 
              RowBox[{"\[Gamma]2", "*", 
               SuperscriptBox["10", "9"]}], ")"}], "*", 
             FractionBox[
              RowBox[{"6", "\[Pi]"}], "2"], "*", 
             SuperscriptBox[
              RowBox[{"(", 
               FractionBox["\[Lambda]p", 
                RowBox[{"2", "\[Pi]"}]], ")"}], "2"], "*", 
             RowBox[{"(", 
              RowBox[{"Im\[Rho]12S", " ", "+", 
               RowBox[{"\[ImaginaryI]", " ", "Re\[Rho]12S"}]}], ")"}]}]}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"\[CapitalOmega]LSignal", "=", 
           RowBox[{"\[CapitalOmega]LSignal", "-", 
            RowBox[{"Deltazz", "*", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{
               RowBox[{"-", "2"}], 
               RowBox[{
                SuperscriptBox["zz", "2"], "/", 
                SuperscriptBox["wz", "2"]}]}]], "*", "nat", "*", 
             RowBox[{"(", 
              RowBox[{"\[Gamma]4", "*", 
               SuperscriptBox["10", "9"]}], ")"}], "*", 
             FractionBox[
              RowBox[{"6", "\[Pi]"}], "2"], "*", 
             SuperscriptBox[
              RowBox[{"(", 
               FractionBox["\[Lambda]L", 
                RowBox[{"2", "\[Pi]"}]], ")"}], "2"], "*", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"Im\[Rho]14S", " ", "+", 
                RowBox[{"\[ImaginaryI]", " ", "Re\[Rho]14S"}]}], ")"}], "/", 
              "6"}]}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"zz", "=", 
           RowBox[{"zz", "+", "Deltazz"}]}]}]}], "]"}], ";", 
       RowBox[{"Iout", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"6", "*", "2", " ", "Is", 
           FractionBox[
            RowBox[{" ", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Abs", "[", "\[CapitalOmega]LSignal", "]"}], "/", 
