     RowBox[{"\:4efb\:610f\:4e24\:7403\:5fc3\:8ddd\:79bb", "\[GreaterEqual]", 
      RowBox[{"2", "r"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dMin", "=", 
     RowBox[{
      RowBox[{"2", " ", "r"}], "-", "tol"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Nearest", " ", "\:7684\:6b63\:786e\:7528\:6cd5"}], "\:ff1a", 
     "\:5148\:5efa\:7acb\:7d22\:5f15\:5668"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nearIndex", "=", 
     RowBox[{"Nearest", "[", 
      RowBox[{"pts", "\[Rule]", 
       RowBox[{"Range", "[", "n", "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"\:67e5\:627e\:6240\:6709", 
     RowBox[{"\[OpenCurlyDoubleQuote]", 
      RowBox[{"\:8ddd\:79bb", "<", "dMin"}], "\[CloseCurlyDoubleQuote]"}], 
     "\:7684\:5bf9"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pairs", "=", 
     RowBox[{
      RowBox[{"Reap", "[", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"nbr", "=", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"nearIndex", "[", 
              RowBox[{
               RowBox[{"pts", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"All", ",", "dMin"}], "}"}]}], "]"}], ",", 
             RowBox[{
              RowBox[{"#", ">", "i"}], "&"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "nbr", "]"}], ">", "0"}], ",", 
            RowBox[{"Sow", "[", 
             RowBox[{"Thread", "[", 
              RowBox[{"{", 
               RowBox[{"i", ",", "nbr"}], "}"}], "]"}], "]"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "n"}], "}"}]}], "]"}], "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"pairs", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"pairs", "===", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"{", "}"}], ",", 
       RowBox[{"Flatten", "[", 
        RowBox[{"pairs", ",", "1"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"pairs", "===", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{
      "Print", "[", 
       "\"\<Non-overlap check: PASS (no pairs with distance < 2r)\>\"", "]"}],
       ",", 
      RowBox[{
       RowBox[{"Print", "[", "\"\<Non-overlap check: FAIL\>\"", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Too-close pair count = \>\"", ",", 
         RowBox[{"Length", "[", "pairs", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<First few pairs (i,j) = \>\"", ",", 
         RowBox[{"Take", "[", 
          RowBox[{"pairs", ",", 
           RowBox[{"Min", "[", 
            RowBox[{"20", ",", 
             RowBox[{"Length", "[", "pairs", "]"}]}], "]"}]}], "]"}]}], "]"}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "\:8ba1\:7b97\:7b2c\:4e00\:5bf9\:7684\:771f\:5b9e\:8ddd\:79bb", 
         "\:ff0c", "\:65b9\:4fbf\:8bca\:65ad"}], "*)"}], 
       RowBox[{"i1", "=", 
        RowBox[{"pairs", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
       RowBox[{"j1", "=", 
        RowBox[{"pairs", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Example pair distance = \>\"", ",", 
         RowBox[{"Norm", "[", 
          RowBox[{
           RowBox[{"pts", "[", 
            RowBox[{"[", "i1", "]"}], "]"}], "-", 
           RowBox[{"pts", "[", 
            RowBox[{"[", "j1", "]"}], "]"}]}], "]"}], ",", 
         "\"\<  threshold = \>\"", ",", 
         RowBox[{"2", " ", "r"}]}], "]"}], ";"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"validQ", "=", 
     RowBox[{"insideQ", "&&", 
      RowBox[{"(", 
       RowBox[{"pairs", "===", 
        RowBox[{"{", "}"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Overall strict validity = \>\"", ",", "validQ"}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", "\n", 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9754880276026063`*^9, 3.9754880276066027`*^9}, {
  3.975493892154211*^9, 3.9754938948522434`*^9}, {3.9754956482154093`*^9, 
