 RowBox[{
  RowBox[{
   SubscriptBox["w", "02"], " ", "=", 
   FractionBox[
    RowBox[{"2", " ", 
     SuperscriptBox["\[ExponentialE]", 
      FractionBox[
       RowBox[{
        RowBox[{"a", " ", 
         SuperscriptBox["d", "2"]}], "-", 
        RowBox[{"2", " ", "c", " ", "d", " ", "f"}], "+", 
        RowBox[{"b", " ", 
