 RowBox[{
  RowBox[{
   SubscriptBox["\[Lambda]", "1"], " ", "=", " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     RowBox[{"2", 
      SuperscriptBox[
       RowBox[{"Sinh", "[", "r", "]"}], "2"]}], "-", 
     RowBox[{
      RowBox[{"Cos", "[", "\[Theta]", "]"}], 
      RowBox[{"Sinh", "[", 
       RowBox[{"2", "r"}], "]"}]}]}], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   SubscriptBox["\[Lambda]", "2"], " ", "=", "  ", 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     RowBox[{"2", 
      SuperscriptBox[
       RowBox[{"Sinh", "[", "r", "]"}], "2"]}], "+", 
     RowBox[{
      RowBox[{"Cos", "[", "\[Theta]", "]"}], 
      RowBox[{"Sinh", "[", 
       RowBox[{"2", "r"}], "]"}]}]}], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   SubscriptBox["\[Lambda]", 
    RowBox[{"3", " "}]], "=", " ", 
   RowBox[{
    RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
    RowBox[{"Sinh", "[", 
     RowBox[{"2", "r"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", "=", " ", 
   SubscriptBox["\[Lambda]", "1"]}], " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b", "=", 
   SubscriptBox["\[Lambda]", "2"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"c", "=", 
   SubscriptBox["\[Lambda]", "3"]}], " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d", "=", 
   RowBox[{"2", "\[ImaginaryI]", " ", 
    SubscriptBox["x", "\[Alpha]"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "=", " ", 
   RowBox[{"2", "\[ImaginaryI]", " ", 
    SubscriptBox["y", "\[Alpha]"]}]}], " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   SubscriptBox["w", "01"], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"2", " "}], "\[Pi]"], "  ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "2"}], "  ", 
       SuperscriptBox[
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             SubscriptBox["x", "\[Alpha]"], "+", 
             RowBox[{"\[ImaginaryI]", "  ", 
              SubscriptBox["y", "\[Alpha]"]}]}], " ", ")"}], " ", 
