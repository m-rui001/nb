       RowBox[{"b", " ", 
        SuperscriptBox["f", "2"]}]}], ")"}], " ", "\[Pi]"}], 
    RowBox[{
     SqrtBox["a"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"a", " ", "b"}], "-", 
       SuperscriptBox["c", "2"]}], ")"}], " ", 
     SqrtBox[
      RowBox[{"b", "-", 
       FractionBox[
        SuperscriptBox["c", "2"], "a"]}]]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
