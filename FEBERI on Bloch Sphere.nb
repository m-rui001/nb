     RowBox[{"dk", " ", "=", " ", 
      RowBox[{"deltak", "/", "Nac"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"krange", "=", 
      RowBox[{"dk", "*", 
       RowBox[{"Table", "[", 
        RowBox[{"x", ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{
            RowBox[{"-", "Nk"}], "/", "2"}], ",", 
