Cell[BoxData[{
 RowBox[{
  RowBox[{"gL", "=", "4.2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xi", " ", "=", " ", "0.0015"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"psizm", " ", "=", " ", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{"I", "*", "gL", "*", 
      RowBox[{"Sin", "[", 
       RowBox[{"zrange", "*", "deltak"}], "]"}]}], "]"}], "*", "psiz0"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"psikm", "=", " ", 
   RowBox[{
    RowBox[{"RotateLeft", "[", 
     RowBox[{
      RowBox[{"InverseFourier", "[", "psizm", "]"}], ",", "0"}], "]"}], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "I"}], "*", "xi", "*", 
      RowBox[{"krange", "^", "2"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"krange", ",", 
      RowBox[{
       RowBox[{"Abs", "[", "psikm", "]"}], "^", "2"}]}], "}"}], "]"}], ",", 
   RowBox[{"Joined", "\[Rule]", "True"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
