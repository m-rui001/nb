Cell[BoxData[{
 RowBox[{
  RowBox[{"dz", " ", "=", " ", 
   RowBox[{"2", "*", 
    RowBox[{"Pi", "/", 
     RowBox[{"(", 
      RowBox[{"dk", "*", "Nk"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zrange", "=", 
   RowBox[{"dz", "*", 
    RowBox[{"Table", "[", 
     RowBox[{"x", ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{
         RowBox[{"-", "Nk"}], "/", "2"}], ",", 
        RowBox[{"Nk", "/", "2"}], ",", "1"}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"psiz0", " ", "=", " ", 
   RowBox[{"RotateLeft", "[", 
    RowBox[{
     RowBox[{"Fourier", "[", "psik0", "]"}], ",", 
     RowBox[{"Nk", "/", "2"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"zrange", ",", 
      RowBox[{
       RowBox[{"Abs", "[", "psiz0", "]"}], "^", "2"}]}], "}"}], "]"}], ",", 
   RowBox[{"Joined", "\[Rule]", "True"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
