      RowBox[{"Style", "[", 
       RowBox[{
       "\"\<|\!\(\*SubscriptBox[\(\[Psi]\), \
\(z\)]\)\!\(\*SuperscriptBox[\(|\), \(2\)]\)\>\"", ",", "32"}], "]"}]}], 
     "}"}]}], ",", 
