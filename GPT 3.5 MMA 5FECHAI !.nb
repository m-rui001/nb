 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"countDigits", "[", "partition_", "]"}], ":=", 
    RowBox[{"Length", "[", 
     RowBox[{"ToString", "[", 
      RowBox[{"Total", "[", "partition", "]"}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", "\:6c47\:603b\:4f4d\:6570", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"totalDigits", "=", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"countDigits", "[", 
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], "*", 
        RowBox[{"#", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "&"}], "/@", "results"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]", "\n", 
