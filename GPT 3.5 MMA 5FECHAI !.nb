Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"partitions", "=", 
    RowBox[{"IntegerPartitions", "[", 
     RowBox[{"5", ",", 
      RowBox[{"{", "3", "}"}], ",", 
      RowBox[{"Range", "[", 
       RowBox[{"5", ",", "1", ",", 
        RowBox[{"-", "1"}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{
  "(*", "\:8ba1\:7b97\:6bcf\:4e2a\:5206\:62c6\:5f62\:5f0f\:7684\:5168\:6392\
\:5217\:53ca\:5176\:6570\:91cf", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"countPermutations", "[", "partition_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"unique", ",", "counts", ",", "totalPermutations"}], "}"}], 
      ",", 
      RowBox[{
       RowBox[{"unique", "=", 
        RowBox[{"Union", "[", "partition", "]"}]}], ";", 
       RowBox[{"(*", "\:627e\:5230\:552f\:4e00\:5143\:7d20", "*)"}], 
       RowBox[{"counts", "=", 
        RowBox[{"Counts", "[", "partition", "]"}]}], ";", 
       RowBox[{
       "(*", "\:7edf\:8ba1\:6bcf\:4e2a\:5143\:7d20\:7684\:6570\:91cf", "*)"}], 
       RowBox[{"totalPermutations", "=", 
        RowBox[{
         RowBox[{"Factorial", "[", 
          RowBox[{"Total", "[", "counts", "]"}], "]"}], "/", 
         RowBox[{"Product", "[", 
          RowBox[{
           RowBox[{"Factorial", "[", 
            RowBox[{"counts", "[", 
             RowBox[{"unique", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"Length", "[", "unique", "]"}]}], "}"}]}], "]"}]}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"partition", ",", "totalPermutations"}], "}"}]}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{
  "(*", "\:8ba1\:7b97\:6240\:6709\:5206\:62c6\:5f62\:5f0f\:53ca\:5176\:6392\
\:5217\:6570", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"results", "=", 
    RowBox[{"countPermutations", "/@", "partitions"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{
  "(*", "\:8f93\:51fa\:5206\:62c6\:5f62\:5f0f\:53ca\:5176\:6392\:5217\:6570", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"results", "//", "TableForm"}], "\[IndentingNewLine]", "\n", 
