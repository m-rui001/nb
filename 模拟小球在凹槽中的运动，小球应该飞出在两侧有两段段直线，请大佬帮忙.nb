Notebook[{

Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"m", "=", "1"}], ";", 
   RowBox[{"mm", "=", "1"}], ";", 
   RowBox[{"v0", "=", "30"}], ";", 
   RowBox[{"g", "=", "10"}], ";", 
   RowBox[{"r", "=", "5"}], ";", 
   RowBox[{"q", "=", "1"}], ";", 
   RowBox[{"p", "=", "0"}], ";", 
   RowBox[{"te", "=", "0"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sol", "=", 
    RowBox[{"NDSolveValue", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"m", " ", "v0"}], "-", 
          RowBox[{"mm", " ", "v0"}]}], "==", 
         RowBox[{
          RowBox[{"m", " ", 
           RowBox[{
            RowBox[{"x", "'"}], "[", "t", "]"}]}], "+", 
          RowBox[{"mm", " ", 
           RowBox[{
            RowBox[{"xx", "'"}], "[", "t", "]"}]}]}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"mm", " ", 
           RowBox[{"v0", "^", "2"}]}], "+", 
          RowBox[{"m", " ", 
           RowBox[{"v0", "^", "2"}]}]}], "==", 
         RowBox[{
          RowBox[{"2", " ", "m", " ", 
           RowBox[{"y", "[", "t", "]"}]}], "+", 
          RowBox[{"q", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"m", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"x", "'"}], "[", "t", "]"}], "^", "2"}]}], "+", 
             RowBox[{"mm", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"xx", "'"}], "[", "t", "]"}], "^", "2"}]}]}], ")"}]}],
           "+", 
          RowBox[{"p", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"m", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"x", "'"}], "[", "te", "]"}], "^", "2"}]}], "+", 
             RowBox[{"mm", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"xx", "'"}], "[", "te", "]"}], "^", "2"}]}]}], 
            ")"}]}], "+", 
          RowBox[{"m", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"y", "'"}], "[", "t", "]"}], "^", "2"}]}]}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"q", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"x", "[", "t", "]"}], "-", 
                RowBox[{"xx", "[", "t", "]"}]}], ")"}], "^", "2"}], "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "r"}], "+", 
                RowBox[{"y", "[", "t", "]"}]}], ")"}], "^", "2"}]}], ")"}]}], 
          "+", 
          RowBox[{"p", " ", 
           RowBox[{
            RowBox[{"x", "''"}], "[", "t", "]"}]}]}], "==", 
         RowBox[{
          RowBox[{"q", " ", 
           RowBox[{"r", "^", "2"}]}], "+", 
          RowBox[{"p", " ", 
           RowBox[{"(", 
            RowBox[{"1", "-", "p"}], ")"}]}]}]}], ",", 
        RowBox[{
         RowBox[{"x", "[", "0", "]"}], "==", "0"}], ",", 
        RowBox[{
         RowBox[{"y", "[", "0", "]"}], "==", "0"}], ",", 
        RowBox[{
         RowBox[{"xx", "[", "0", "]"}], "==", "0"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"xx", "'"}], "[", "0", "]"}], "==", 
         RowBox[{"-", "v0"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"x", "'"}], "[", "0", "]"}], "==", "v0"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"y", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
        RowBox[{"WhenEvent", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"y", "[", "t", "]"}], ">=", "r"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"q", "=", "0"}], ",", 
            RowBox[{"p", "=", "1"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"WhenEvent", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"y", "[", "t", "]"}], "<", "r"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"q", "=", "1"}], ",", 
            RowBox[{"p", "=", "0"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"WhenEvent", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"y", "[", "t", "]"}], "]"}], "-", "r"}], "<=", "0.01"}], 
          ",", 
          RowBox[{"te", "=", "t"}]}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "xx"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "100"}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"sol", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "[", "t", "]"}], ",", 
     RowBox[{
      RowBox[{"sol", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "[", "t", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "10"}], "}"}]}], "]"}]}], "Input",
