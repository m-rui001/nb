Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"While", "[", 
    RowBox[{
     RowBox[{"j", "\[LessEqual]", "n"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"i", "=", "0"}], ";", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{"i", "\[LessEqual]", "j"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"d", "=", 
          RowBox[{"ImplicitRegion", "[", 
           RowBox[{
            RowBox[{"y", "\[GreaterEqual]", 
             RowBox[{"j", "*", 
              RowBox[{"(", 
               RowBox[{"x", "-", 
                FractionBox["i", "j"]}], ")"}]}]}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"e", "=", 
          RowBox[{"ImplicitRegion", "[", 
           RowBox[{
            RowBox[{"y", "\[GreaterEqual]", 
             RowBox[{
              RowBox[{"-", "j"}], "*", 
              RowBox[{"(", 
               RowBox[{"x", "-", 
                FractionBox["i", "j"]}], ")"}]}]}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"c", "=", 
          RowBox[{"RegionIntersection", "[", 
           RowBox[{"d", ",", "e"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"a", "=", 
          RowBox[{"RegionUnion", "[", 
           RowBox[{"a", ",", "c"}], "]"}]}], ";", 
         RowBox[{"i", "++"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"j", "++"}]}]}], "]"}], ";"}], "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.91042237740986*^9, 3.9104223817178507`*^9}, {
  3.910422505933933*^9, 3.9104225836690755`*^9}, {3.9104237277895823`*^9, 
