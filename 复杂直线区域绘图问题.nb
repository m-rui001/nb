Cell[BoxData[
 RowBox[{"ImplicitRegion", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"y", "\[GreaterEqual]", "x"}], "&&", 
      RowBox[{
       RowBox[{"x", "+", "y"}], "\[GreaterEqual]", "0"}]}], ")"}], "||", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"1", "+", "y"}], "\[GreaterEqual]", "x"}], "&&", 
      RowBox[{
       RowBox[{"x", "+", "y"}], "\[GreaterEqual]", "1"}]}], ")"}], "||", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"y", "\[GreaterEqual]", 
       RowBox[{"2", " ", "x"}]}], "&&", 
      RowBox[{"y", "\[GreaterEqual]", 
       RowBox[{
        RowBox[{"-", "2"}], " ", "x"}]}]}], ")"}], "||", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"1", "+", "y"}], "\[GreaterEqual]", 
       RowBox[{"2", " ", "x"}]}], "&&", 
      RowBox[{
       RowBox[{
        RowBox[{"2", " ", "x"}], "+", "y"}], "\[GreaterEqual]", "1"}]}], 
     ")"}], "||", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"2", "+", "y"}], "\[GreaterEqual]", 
       RowBox[{"2", " ", "x"}]}], "&&", 
      RowBox[{
       RowBox[{
        RowBox[{"2", " ", "x"}], "+", "y"}], "\[GreaterEqual]", "2"}]}], 
     ")"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y"}], "}"}]}], "]"}]], "Output",
 CellChangeTimes->{{3.9104265273471403`*^9, 3.910426530740189*^9}, 
   3.9104268654134293`*^9},
 CellLabel->
  "Out[116]=",ExpressionUUID->"d0439c1e-55b5-41d2-83af-40c26fd4371e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"y", "\[GreaterEqual]", "x"}], "&&", 
    RowBox[{
     RowBox[{"x", "+", "y"}], "\[GreaterEqual]", "0"}]}], ")"}], "||", 
  RowBox[{"(", 
