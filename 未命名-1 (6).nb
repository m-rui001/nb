     RowBox[{"Symbol", "[", "\"\<C1\>\"", "]"}], ",", 
     RowBox[{"Symbol", "[", "\"\<D1\>\"", "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"finalResult", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"RecursionRelation", "[", 
     RowBox[{"start", ",", "relation", ",", "n"}], "]"}], "]"}]}], 
  ";"}]}], "Input",
