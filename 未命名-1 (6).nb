Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"RecursionRelation", "[", 
    RowBox[{"start_", ",", "relation_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"matList", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"relation", "[", 
           RowBox[{"start", ",", "i"}], "]"}], "[", 
          RowBox[{"[", "3", "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"Fold", "[", 
       RowBox[{"Dot", ",", 
        RowBox[{"IdentityMatrix", "[", 
         RowBox[{"Length", "[", "start", "]"}], "]"}], ",", "matList"}], 
       "]"}], ".", "start"}]}], "]"}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"relation", "[", 
    RowBox[{"current_", ",", "i_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "nextVars", ",", "nextValues", ",", "ki", ",", "hi", ",", 
       "\[Lambda]i"}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ki", ",", "hi", ",", "\[Lambda]i"}], "}"}], "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Symbol", "[", 
          RowBox[{"\"\<k\>\"", "<>", 
           RowBox[{"ToString", "[", "i", "]"}]}], "]"}], ",", 
         RowBox[{"Symbol", "[", 
          RowBox[{"\"\<h\>\"", "<>", 
           RowBox[{"ToString", "[", "i", "]"}]}], "]"}], ",", 
         RowBox[{"Symbol", "[", 
          RowBox[{"\"\<\[Lambda]\>\"", "<>", 
           RowBox[{"ToString", "[", "i", "]"}]}], "]"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"nextVars", "=", 
       RowBox[{"Symbol", "/@", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<A\>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"i", "+", "1"}], "]"}]}], ",", 
          RowBox[{"\"\<B\>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"i", "+", "1"}], "]"}]}], ",", 
          RowBox[{"\"\<C\>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"i", "+", "1"}], "]"}]}], ",", 
          RowBox[{"\"\<D\>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"i", "+", "1"}], "]"}]}]}], "}"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"nextValues", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ki", "/", 
            RowBox[{"(", 
             RowBox[{"ki", "+", "1"}], ")"}]}], ",", "0", ",", "0", ",", 
           "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"hi", " ", 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"ki", "/", 
               RowBox[{"(", 
                RowBox[{"ki", "+", "1"}], ")"}]}]}], ")"}]}], ",", "1", ",", 
           "0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", 
           RowBox[{"\[Lambda]i", "/", 
            RowBox[{"(", 
             RowBox[{"\[Lambda]i", "+", "1"}], ")"}]}], ",", "0"}], "}"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", 
           RowBox[{"hi", " ", 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"\[Lambda]i", "/", 
               RowBox[{"(", 
                RowBox[{"\[Lambda]i", "+", "1"}], ")"}]}]}], ")"}]}], ",", 
           "1"}], "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"nextValues", "=", 
       RowBox[{"nextValues", ".", "current"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"nextVars", ",", "nextValues", ",", "nextValues"}], "}"}]}]}], 
    "]"}]}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{"Symbol", "[", "\"\<n\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"start", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Symbol", "[", "\"\<A1\>\"", "]"}], ",", 
