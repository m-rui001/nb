Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{"ClearAll", "[", 
  RowBox[{"\"\<Global`*\>\"", ",", "Derivative", ",", "Subscript"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SQF", "=", 
   RowBox[{
    SubscriptBox["w", "2"], "-", 
    FractionBox["1", "2"]}]}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Squeezing", " ", "parameter", " ", 
     SubscriptBox["S", "\[Theta]"]}], " ", "=", " ", 
    RowBox[{"<", 
     SuperscriptBox[
      SubscriptBox["X", "\[Theta]"], "2"], ">", 
     RowBox[{"-", 
      RowBox[{"<", 
       SubscriptBox["X", "\[Theta]"], 
       SuperscriptBox[">", "2"], 
       RowBox[{"-", 
        FractionBox["1", "2"]}]}]}]}]}], " ", "*)"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    SubscriptBox["w", "2"], "=", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubscriptBox["q", "2"], 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "2"}], "\[ImaginaryI]", " ", "\[Theta]"}]]}], "+", 
       RowBox[{
        SubscriptBox["q", "22"], 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"2", "\[ImaginaryI]", " ", "\[Theta]"}]]}], "+", 
       RowBox[{"2", " ", 
        SubscriptBox["q", "3"]}]}], ")"}]}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"where", " ", 
     SubscriptBox["X", "2"]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"<", 
      SuperscriptBox[
       SubscriptBox["X", "\[Theta]"], "2"], ">"}], " ", "=", 
     RowBox[{
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"2", 
           RowBox[{"Re", "[", 
            RowBox[{"<", 
             SuperscriptBox["a", "2"], ">", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{
               RowBox[{"-", "2"}], "\[ImaginaryI]", " ", "\[Theta]"}]]}], 
            "]"}]}], "+", "2"}], "<", 
         RowBox[{
          SuperscriptBox["a", "+"], "a"}], ">", 
         RowBox[{"+", "1"}]}], ")"}]}], "=", 
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", 
          RowBox[{"Re", "[", 
           RowBox[{
            SubscriptBox["Q", "2"], "*", 
            SuperscriptBox["\[ExponentialE]", 
             RowBox[{
              RowBox[{"-", "2"}], "\[ImaginaryI]", " ", "\[Theta]"}]]}], 
           "]"}]}], "+", 
         RowBox[{"2", 
          SubscriptBox["Q", "3"]}], "+", "1"}], ")"}]}]}]}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   SubscriptBox["q", "2"], "=", 
   RowBox[{
    FractionBox["1", 
     SuperscriptBox[
      RowBox[{"Sinh", "[", "r", "]"}], "2"]], 
    RowBox[{"(", " ", 
     RowBox[{"3", "  ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]], " ", 
      SuperscriptBox[
       RowBox[{"Sinh", "[", "r", "]"}], "3"], 
      RowBox[{"Cosh", "[", "r", "]"}]}], " ", ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   SubscriptBox["q", "22"], "=", 
   RowBox[{
    FractionBox["1", 
     SuperscriptBox[
      RowBox[{"Sinh", "[", "r", "]"}], "2"]], 
    RowBox[{"(", " ", 
     RowBox[{"3", "  ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Theta]"}]], " ", 
      SuperscriptBox[
       RowBox[{"Sinh", "[", "r", "]"}], "3"], 
      RowBox[{"Cosh", "[", "r", "]"}]}], " ", ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   SubscriptBox["q", 
    RowBox[{"3", " "}]], "=", 
   RowBox[{
    FractionBox["1", 
     SuperscriptBox[
      RowBox[{"Sinh", "[", "r", "]"}], "2"]], 
