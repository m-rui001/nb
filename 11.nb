Cell[BoxData[{
 RowBox[{"ClearAll", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"\"\<`*\>\"", ",", " ", "Subscript", ",", " ", "Derivative"}], 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"\"\<Global`*\>\"", ",", "Derivative", ",", "Subscript"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SQFF", "=", 
   FractionBox[
    RowBox[{"2", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Re", "[", " ", 
        RowBox[{
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", "2"}], "\[ImaginaryI]", " ", "\[Theta]"}]], " ", 
         SubscriptBox["F", "2"]}], "]"}], "-", 
       RowBox[{"2", 
        SuperscriptBox[
         RowBox[{"Re", "[", " ", 
          RowBox[{
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{
             RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Theta]"}]], " ", 
           SubscriptBox["F", "1"]}], " ", "]"}], "2"]}], "+", 
       SubscriptBox["F", "3"]}], ")"}]}], 
    RowBox[{
     RowBox[{"2", 
      SuperscriptBox[
       RowBox[{"Sinh", "[", "\[Lambda]", "]"}], "2"]}], "+", "1"}]]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   SubscriptBox["F", "1"], "=", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"Sinh", "[", 
     RowBox[{"2", "\[Lambda]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   SubscriptBox["F", "2"], "=", 
   RowBox[{
    FractionBox["1", "2"], 
    SuperscriptBox[
     RowBox[{"Sinh", "[", 
      RowBox[{"2", "\[Lambda]"}], "]"}], "2"]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   SubscriptBox["F", "3"], "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "4"], 
     SuperscriptBox[
      RowBox[{"Sinh", "[", 
       RowBox[{"2", "\[Lambda]"}], "]"}], "2"]}], "+", 
    SuperscriptBox[
     RowBox[{"Sinh", "[", "\[Lambda]", "]"}], "4"]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"range", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", 
     FractionBox["\[Pi]", "2"]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"a", "=", 
