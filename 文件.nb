         RowBox[{"sol", " ", "=", " ", 
          RowBox[{"First", "[", 
           RowBox[{"NDSolve", "[", 
            RowBox[{
             RowBox[{"{", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{
