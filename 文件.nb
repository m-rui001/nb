                RowBox[{"b", "[", 
                 RowBox[{"t", " ", "/;", " ", 
                  RowBox[{"t", " ", "\[LessEqual]", " ", "0"}]}], "]"}], "  ",
                 "\[Equal]", "0.625"}]}], "}"}], ",", "\[IndentingNewLine]", 
