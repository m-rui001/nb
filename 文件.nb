                  RowBox[{"t", " ", "\[LessEqual]", " ", "0"}]}], "]"}], " ", 
                "\[Equal]", "80"}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{
                 RowBox[{"b", "'"}], "[", "t", "]"}], " ", "\[Equal]", 
